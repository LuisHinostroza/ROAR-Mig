REPORT zmfi_mex_informe2.
TYPE-POOLS: abap, slis.
TABLES: bkpf , bseg , bset , with_item , lfa1.

DATA: gt_bkpf TYPE TABLE OF bkpf,
      gt_bseg TYPE TABLE OF bseg,
      gs_bkpf TYPE bkpf,
      gs_bseg TYPE bseg.

TYPES: BEGIN OF GTY_SALIDA,
  bldat    TYPE bkpf-bldat,         "Fecha documento
  budat    TYPE bkpf-budat,         "Fecha contabilización
  monat    TYPE bkpf-monat,         "Período
  xblnr    TYPE bkpf-xblnr,         "Referencia
  folio    TYPE string,             "Nuevo Folio Fiscal
  wrbtr    TYPE bseg-wrbtr,         "Importe MD
  waers    TYPE bkpf-waers,         "Moneda MD
  dmbtr    TYPE bseg-dmbtr,         "Importe ML
  mwskz    TYPE bseg-mwskz,         "Indicador IVA
  fwste    TYPE bset-FWSTE,         "Importe IVA
  wt_qbshb TYPE with_item-wt_qbshb, "Retenciones
  belnr    TYPE bkpf-belnr,         "Número de Documento
  augbl    TYPE bseg-augbl,         "Documento de compensación
  augdt    TYPE bseg-augdt,         "Fecha de compensación
  blart    TYPE bkpf-blart,         "Clase de documento
  lifnr    TYPE lfa1-lifnr,         "Acreedor
  kunnr    TYPE kna1-kunnr,         "Cliente
  stcd1    TYPE lfa1-stcd1,         "R.F.C
  name1    TYPE lfa1-name1,         "Nombre o Razón Social
  land1    TYPE lfa1-land1,         "Clave país
  pstlz    TYPE lfa1-pstlz,         "Código Postal
  hkont    TYPE bseg-hkont,         "Cuenta contable GTO
  hkont_i  TYPE bseg-hkont,         "Cuenta contable IVA
  sgtxt    TYPE bseg-sgtxt,         "Texto/Concepto
  kostl    TYPE bseg-kostl,         "Ceco
  usnam    TYPE bkpf-usnam,         "Usuario registro
END OF gty_salida.

DATA: gt_salida  TYPE TABLE OF gty_salida,
      gs_salida  TYPE gty_salida.
DATA: t_fieldcat TYPE TABLE OF slis_fieldcat_alv.
DATA: w_fieldcat TYPE slis_fieldcat_alv.

*Parámetros de búsqueda
DATA: gv_koart TYPE bseg-koart.

TYPES: BEGIN OF gty_r_mwskz,
          sign   TYPE c LENGTH 1,
          option TYPE c LENGTH 2,
          low    TYPE bseg-mwskz,
          high   TYPE bseg-mwskz,
       END OF gty_r_mwskz,
       BEGIN OF gty_r_blart,
          sign   TYPE c LENGTH 1,
          option TYPE c LENGTH 2,
          low    TYPE bkpf-blart,
          high   TYPE bkpf-blart,
       END OF gty_r_blart,
       BEGIN OF gty_anul,
          blart     TYPE bkpf-blart,
          anulacion TYPE bkpf-blart,
       END OF gty_anul.

DATA: "Indicador de retención
      gr_mwskz TYPE TABLE OF gty_r_mwskz,
      "Clase de documento
      gr_blart TYPE TABLE OF gty_r_blart,
      "Anulaciones
      gr_anul  TYPE TABLE OF gty_r_blart,
      gt_anul  TYPE TABLE OF gty_anul.

*&---------------------------------------------------------------------*
*&  Include           ZMFI_MEX_INFORME_2_C01
*&---------------------------------------------------------------------*
CLASS lcl_event DEFINITION.

  PUBLIC SECTION.

    METHODS: link_click FOR EVENT link_click OF cl_salv_events_table "click en enlace
                          IMPORTING row
                                    column,
               on_user_command FOR EVENT before_user_command OF cl_gui_alv_grid
                          IMPORTING e_ucomm,

               on_after_refresh FOR EVENT after_refresh OF cl_gui_alv_grid
                          IMPORTING sender.

    CLASS-DATA grid_ref TYPE REF TO cl_gui_alv_grid..

ENDCLASS.                    "lcl_event DEFINITION

*----------------------------------------------------------------------*
*       CLASS lcl_event IMPLEMENTATION
*----------------------------------------------------------------------*
*
*----------------------------------------------------------------------*
CLASS lcl_event IMPLEMENTATION.
  METHOD link_click.

    IF row NE 0.
      READ TABLE gt_salida
      INTO gs_salida
      INDEX row.

      IF sy-subrc = 0.
        CASE column.
          WHEN 'BELNR'.
            SET PARAMETER ID: 'BUK' FIELD 'MEXA',
                              'GJR' FIELD gs_salida-budat(4),
                              'BLN' FIELD gs_salida-belnr.
            CALL TRANSACTION 'FB03' AND SKIP FIRST SCREEN.
          WHEN OTHERS.
        ENDCASE.
      ENDIF.
    ENDIF.

    CLEAR: gs_salida.
  ENDMETHOD.                    "link_click

  METHOD on_after_refresh.
    " Solo la primera vez, ligamos el handler de on_user_command
    IF grid_ref IS INITIAL.
      grid_ref = sender.              " cl_gui_alv_grid
      SET HANDLER on_user_command FOR grid_ref.
    ENDIF.
  ENDMETHOD.                    "on_after_refresh

  METHOD on_user_command.
    DATA: lo_excel        TYPE REF TO zcl_excel,
          lo_excel_writer TYPE REF TO zcl_excel_writer_2007,
          lo_worksheet    TYPE REF TO zcl_excel_worksheet,
          lv_content      TYPE xstring,
          lv_name         TYPE string,
          lv_bytecount    TYPE i,
          lt_file_tab     TYPE solix_tab,
          lv_path         TYPE string,
          lv_filename     TYPE string,
          lv_fullpath     TYPE string,
          lv_action       TYPE i.

    CASE e_ucomm.
      WHEN '&ZEXCEL'.
        CREATE OBJECT lo_excel.
        lo_worksheet = lo_excel->get_active_worksheet( ).
        lo_worksheet->bind_table( gt_salida ).
        lo_worksheet->calculate_column_widths( ).

        CREATE OBJECT lo_excel_writer.
        lv_content = lo_excel_writer->zif_excel_writer~write_file( lo_excel ).

        CALL METHOD cl_gui_frontend_services=>file_save_dialog
          EXPORTING
            window_title      = 'Descargar Excel'
            default_extension = 'XLSX'
            default_file_name = '.xlsx'
          CHANGING
            filename          = lv_filename
            path              = lv_path
            fullpath          = lv_fullpath
            user_action       = lv_action.

        IF lv_action <> cl_gui_frontend_services=>action_cancel.
          CALL FUNCTION 'SCMS_XSTRING_TO_BINARY'
            EXPORTING
              buffer        = lv_content
            IMPORTING
              output_length = lv_bytecount
            TABLES
              binary_tab    = lt_file_tab.

          CALL METHOD cl_gui_frontend_services=>gui_download
            EXPORTING
              bin_filesize            = lv_bytecount
              filename                = lv_filename
              filetype                = 'BIN'
            CHANGING
              data_tab                = lt_file_tab
            EXCEPTIONS
              file_write_error        = 1
              no_batch                = 2
              gui_refuse_filetransfer = 3
              invalid_type            = 4
              no_authority            = 5
              unknown_error           = 6
              header_not_allowed      = 7
              separator_not_allowed   = 8
              filesize_not_allowed    = 9
              header_too_long         = 10
              dp_error_create         = 11
              dp_error_send           = 12
              dp_error_write          = 13
              unknown_dp_error        = 14
              access_denied           = 15
              dp_out_of_memory        = 16
              disk_full               = 17
              dp_timeout              = 18
              file_not_found          = 19
              dataprovider_exception  = 20
              control_flush_error     = 21
              OTHERS                  = 22.
        ENDIF.

        EXIT.
      WHEN OTHERS.
    ENDCASE.
  ENDMETHOD.                    "on_user_command

ENDCLASS.                    "lcl_event IMPLEMENTATION


