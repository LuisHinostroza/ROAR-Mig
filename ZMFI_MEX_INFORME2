*&---------------------------------------------------------------------*
*&      Form  GET_ALV
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM get_alv .
  DATA: lo_alv        TYPE REF TO cl_salv_table,
        lo_cols       TYPE REF TO cl_salv_columns_table,
        lo_col        TYPE REF TO cl_salv_column,
        lo_column     TYPE REF TO cl_salv_column_table,
        lo_funcs      TYPE REF TO cl_salv_functions,
        lo_selections TYPE REF TO cl_salv_selections,
        ls_ref        TYPE salv_s_ddic_reference,
        lo_events     TYPE REF TO cl_salv_events_table,
        lo_event_handler TYPE REF TO lcl_event.

  TRY.
    CALL METHOD cl_salv_table=>factory
      IMPORTING
        r_salv_table = lo_alv
      CHANGING
        t_table      = gt_salida.

    "Status
    lo_alv->set_screen_status(
      pfstatus      = 'STANDARD_FULLSCREEN'
      report        = sy-repid
      set_functions = cl_salv_table=>c_functions_all ).

    " Funciones
    lo_funcs = lo_alv->get_functions( ).

    " Columnas
    lo_cols = lo_alv->get_columns( ).
    lo_cols->set_optimize( 'X' ).

    lo_selections = lo_alv->get_selections( ).
    lo_selections->set_selection_mode( cl_salv_selections=>row_column ).

    "Enlace documento
    lo_column ?= lo_cols->get_column( 'BELNR' ).
    lo_column->set_cell_type( if_salv_c_cell_type=>hotspot ).

    "Nombres fieldcat
    LOOP AT t_fieldcat INTO w_fieldcat.
      lo_col = lo_cols->get_column( w_fieldcat-fieldname ).
      lo_col->set_short_text( w_fieldcat-seltext_s ).
      lo_col->set_medium_text( w_fieldcat-seltext_m ).
      lo_col->set_long_text( w_fieldcat-seltext_l ).
      lo_col->set_output_length( w_fieldcat-outputlen ).
    ENDLOOP.

    "Double_click & EXCEL
    lo_events = lo_alv->get_event( ).
    CREATE OBJECT lo_event_handler.
    SET HANDLER lo_event_handler->link_click FOR lo_events.
    SET HANDLER lo_event_handler->on_after_refresh FOR ALL INSTANCES.

    lo_alv->display( ).
  ENDTRY.
ENDFORM.                    " GET_ALV
