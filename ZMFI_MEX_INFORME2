*&  Include           ZMFI_MEX_INFORME_2_F01
*&---------------------------------------------------------------------*
*&---------------------------------------------------------------------*
*&      Form  GET_SEARCH_PARAMETERS
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM get_search_parameters.
  CONSTANTS: lc_sign_I    TYPE c LENGTH 1 VALUE 'I',
             lc_option_EQ TYPE c LENGTH 2 VALUE 'EQ'.

  FIELD-SYMBOLS: <fs_r_mwskz> TYPE gty_r_mwskz,
                 <fs_r_blart> TYPE gty_r_blart.

*Cuenta de acreedor o deudor
  CASE abap_true.
    WHEN rb_ingr.
      gv_koart = 'D'.
    WHEN rb_gasto.
      gv_koart = 'K'.
    WHEN OTHERS.
  ENDCASE.

*Indicador de impuestos
  SELECT valor1 AS low
  FROM zfi_ctes
  INTO CORRESPONDING FIELDS OF TABLE gr_mwskz
  WHERE clave1 EQ sy-cprog
    AND clave2 EQ 'MWSKZ'
    AND clave3 EQ gv_koart.

  LOOP AT gr_mwskz ASSIGNING <fs_r_mwskz>.
    <fs_r_mwskz>-sign = lc_sign_I.
    <fs_r_mwskz>-option = lc_option_EQ.
  ENDLOOP.

  "Clase de documento
  SELECT valor1 AS low
  FROM zfi_ctes
  INTO CORRESPONDING FIELDS OF TABLE gr_blart
  WHERE clave1 EQ sy-cprog
    AND clave2 EQ 'BLART'
    AND clave3 EQ gv_koart.

  LOOP AT gr_blart ASSIGNING <fs_r_blart>.
    <fs_r_blart>-sign = lc_sign_I.
    <fs_r_blart>-option = lc_option_EQ.
  ENDLOOP.

  "Anulaciones
  """Rango anulaciones
  SELECT clave4 AS low
  FROM zfi_ctes
  INTO CORRESPONDING FIELDS OF TABLE gr_anul
  WHERE clave1 EQ sy-cprog
    AND clave2 EQ 'BLART'
    AND clave3 EQ gv_koart.

  SORT gr_anul BY low.
  DELETE ADJACENT DUPLICATES FROM gr_anul COMPARING low.

  LOOP AT gr_anul ASSIGNING <fs_r_blart>.
    <fs_r_blart>-sign = lc_sign_I.
    <fs_r_blart>-option = lc_option_EQ.
  ENDLOOP.

  """Correspondencia entre anulación y clase de documento
  SELECT valor1 AS blart
         clave4 AS anulacion
  FROM zfi_ctes
  INTO CORRESPONDING FIELDS OF TABLE gt_anul
  WHERE clave1 EQ sy-cprog
    AND clave2 EQ 'BLART'
    AND clave3 EQ gv_koart.

ENDFORM.                    " get_sets
*&---------------------------------------------------------------------*
*&      Form  GET_DATA
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM get_data .

  DATA: lt_bseg_aux TYPE TABLE OF bseg.

  SELECT *
    FROM bkpf
    INTO TABLE gt_bkpf
      WHERE bukrs IN s_bukrs
       AND  belnr IN s_belnr
       AND  budat IN s_budat
       AND  xblnr IN s_xblnr
       AND  blart IN gr_blart.

  PERFORM get_anulaciones CHANGING gt_bkpf.

  IF gt_bkpf[] IS NOT INITIAL.
    SELECT *
      FROM bseg
        INTO TABLE lt_bseg_aux
          FOR ALL ENTRIES IN gt_bkpf
            WHERE bukrs = gt_bkpf-bukrs
              AND belnr = gt_bkpf-belnr
              AND gjahr = gt_bkpf-gjahr
              AND koart = gv_koart          "se filtran documentos por clase de cuenta
              AND mwskz IN gr_mwskz         "se filtran documentos por indicador de impuestos
              AND (    lifnr IN s_partnr
                    OR kunnr IN s_partnr ). "se filtran documentos por tercero

    SORT lt_bseg_aux BY bukrs belnr gjahr.
    DELETE ADJACENT DUPLICATES FROM lt_bseg_aux COMPARING bukrs belnr gjahr.

    IF lt_bseg_aux[] IS NOT INITIAL.
      SELECT *
      FROM bseg
      INTO TABLE gt_bseg
        FOR ALL ENTRIES IN lt_bseg_aux
          WHERE bukrs = lt_bseg_aux-bukrs
            AND belnr = lt_bseg_aux-belnr
            AND gjahr = lt_bseg_aux-gjahr. "se recogen el resto de posiciones sin los filtros anteriores
    ENDIF.
  ENDIF.

ENDFORM.                    " GET_DATA
*&---------------------------------------------------------------------*
*&      Form  GET_ANULACIONES
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      <--CT_BKPF  text
*----------------------------------------------------------------------*
FORM get_anulaciones CHANGING ct_bkpf LIKE gt_bkpf.

  DATA: lt_bkpf_anulaciones TYPE TABLE OF bkpf,
        lt_bkpf_anulados    TYPE TABLE OF bkpf,
        ls_bkpf_anulados    TYPE bkpf.

  FIELD-SYMBOLS: <fs_bkpf> TYPE bkpf.

  SELECT *
    FROM bkpf
    INTO TABLE lt_bkpf_anulaciones
      WHERE bukrs IN s_bukrs
       AND  belnr IN s_belnr
       AND  budat IN s_budat
       AND  xblnr IN s_xblnr
       AND  blart IN gr_anul.

  CHECK sy-subrc IS INITIAL.

  SELECT *
    FROM bkpf
    INTO TABLE lt_bkpf_anulados
    FOR ALL ENTRIES IN lt_bkpf_anulaciones
      WHERE bukrs EQ lt_bkpf_anulaciones-bukrs
        AND belnr EQ lt_bkpf_anulaciones-stblg
        AND gjahr EQ lt_bkpf_anulaciones-stjah
        AND belnr NE space
        AND blart IN gr_blart.

  CHECK sy-subrc IS INITIAL.

  """Se descartan anulaciones que no correspondan con las clases de documento en el rango gr_balrt
  LOOP AT lt_bkpf_anulaciones ASSIGNING <fs_bkpf>.
    READ TABLE lt_bkpf_anulados
    WITH KEY bukrs = <fs_bkpf>-bukrs
             belnr = <fs_bkpf>-stblg
             gjahr = <fs_bkpf>-stjah
    INTO ls_bkpf_anulados.

    IF sy-subrc IS INITIAL.
      READ TABLE gt_anul
      WITH KEY blart = ls_bkpf_anulados-blart
               anulacion = <fs_bkpf>-blart
      TRANSPORTING NO FIELDS.

      IF sy-subrc IS INITIAL.
        APPEND <fs_bkpf> TO ct_bkpf.
      ENDIF.
    ENDIF.

    CLEAR: ls_bkpf_anulados.
  ENDLOOP.

ENDFORM.                    " GET_ANULACIONES
*&---------------------------------------------------------------------*
*&      Form  ARMA_SALIDA
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM arma_salida .
  DATA: ls_lfa1 TYPE lfa1,
        ls_kna1 TYPE kna1,
        ls_bsec TYPE bsec.
  DATA: ls_bseg TYPE bseg.
  DATA: lt_bset TYPE TABLE OF bset,
        ls_bset TYPE bset.
  DATA: lt_with_item TYPE TABLE OF with_item,
        ls_with_item TYPE with_item.
  DATA: lv_name TYPE tdobname.
  DATA lt_lines TYPE STANDARD TABLE OF tline.

  FIELD-SYMBOLS: <fs_line> TYPE tline.

  LOOP AT gt_bseg INTO gs_bseg WHERE koart = gv_koart
                                 AND mwskz IN gr_mwskz.
    CLEAR gs_salida.

    ""Campos BKPF
    READ TABLE gt_bkpf INTO gs_bkpf WITH KEY bukrs = gs_bseg-bukrs
                                             belnr = gs_bseg-belnr
                                             gjahr = gs_bseg-gjahr.
    IF sy-subrc EQ 0.
      "1.- Fecha de documento
      gs_salida-bldat = gs_bkpf-bldat.
      "2.- Fecha contable
      gs_salida-budat = gs_bkpf-budat.
      "3.- Periodo
      gs_salida-monat = gs_bkpf-monat.
      "4.- Referencia
      gs_salida-xblnr = gs_bkpf-xblnr.
      "5.- Nuevo folio fiscal
      CONCATENATE gs_bkpf-bukrs gs_bkpf-belnr gs_bkpf-gjahr INTO lv_name.

      CALL FUNCTION 'READ_TEXT'
        EXPORTING
          id                      = 'YUUD'
          language                = sy-langu
          name                    = lv_name
          object                  = 'BELEG'
        TABLES
          lines                   = lt_lines
        EXCEPTIONS
          id                      = 1
          language                = 2
          name                    = 3
          not_found               = 4
          object                  = 5
          reference_check         = 6
          wrong_access_to_archive = 7
          OTHERS                  = 8.
      CLEAR: lv_name.

      IF sy-subrc <> 0.
        CLEAR lt_lines.
      ELSE.
        IF sy-subrc <> 0.
          CLEAR lt_lines.
        ELSE.
          LOOP AT lt_lines ASSIGNING <fs_line>.
            gs_salida-folio = <fs_line>-tdline.
          ENDLOOP.
        ENDIF.
      ENDIF.

      IF p_folio IS NOT INITIAL. "Fltro folio fiscal
        CHECK gs_salida-folio EQ p_folio.
      ENDIF.

      "7.- Moneda
      gs_salida-waers = gs_bkpf-waers.
      "12.-Numero de documento
      gs_salida-belnr = gs_bkpf-belnr.
      "15.- Clase de documento
      gs_salida-blart = gs_bkpf-blart.
      "26.- Usuario registrado
      gs_salida-usnam = gs_bkpf-usnam.

      ""Campos Bseg
*      "6.- Importe MD
*      gs_salida-wrbtr = gs_bseg-wrbtr.
*      "8.- Importe ML
*      gs_salida-dmbtr = gs_bseg-dmbtr.
      "13.- Documento compensacion
      gs_salida-augbl = gs_bseg-augbl.
      "14.- Fecha de compensacion
      gs_salida-augdt = gs_bseg-augdt.
      "16.- Acreedor
      gs_salida-lifnr = gs_bseg-lifnr.
      "17.- Cliente
      gs_salida-kunnr = gs_bseg-kunnr.
      "24.- Texto
      gs_salida-sgtxt = gs_bseg-sgtxt.

      "Campos Proveedor
      IF gs_salida-lifnr IS NOT INITIAL.
        SELECT SINGLE *
          FROM bsec
            INTO ls_bsec
              WHERE bukrs = gs_bseg-bukrs
                AND belnr = gs_bseg-belnr
                AND gjahr = gs_bseg-gjahr
                AND buzei = gs_bseg-buzei.
        IF sy-subrc EQ 0.
          "18.- R.F.C
          gs_salida-stcd1 = ls_bsec-stcd1.
          "19.- Nombre
          gs_salida-name1 = ls_bsec-name1.
          "20.- Pais
          gs_salida-land1 = ls_bsec-land1.
          "21.- Codigo Postal
          gs_salida-pstlz = ls_bsec-pstlz.
        ELSE.
          SELECT SINGLE *
            FROM lfa1
              INTO ls_lfa1
                WHERE lifnr = gs_bseg-lifnr.
          IF sy-subrc EQ 0.
            "18.- R.F.C
            gs_salida-stcd1 = ls_lfa1-stcd1.
            "19.- Nombre
            gs_salida-name1 = ls_lfa1-name1.
            "20.- Pais
            gs_salida-land1 = ls_lfa1-land1.
            "21.- Codigo Postal
            gs_salida-pstlz = ls_lfa1-pstlz.
          ENDIF.
        ENDIF.
      ENDIF.
      "Campos Deudor
      IF gs_salida-kunnr IS NOT INITIAL.
        SELECT SINGLE *
          FROM bsec
            INTO ls_bsec
              WHERE bukrs = gs_bseg-bukrs
                AND belnr = gs_bseg-belnr
                AND gjahr = gs_bseg-gjahr
                AND buzei = gs_bseg-buzei.
        IF sy-subrc EQ 0.
          "18.- R.F.C
          gs_salida-stcd1 = ls_bsec-stcd1.
          "19.- Nombre
          gs_salida-name1 = ls_bsec-name1.
          "20.- Pais
          gs_salida-land1 = ls_bsec-land1.
          "21.- Codigo Postal
          gs_salida-pstlz = ls_bsec-pstlz.
        ELSE.
          SELECT SINGLE *
            FROM kna1
              INTO ls_kna1
                WHERE kunnr = gs_bseg-kunnr.
          IF sy-subrc EQ 0.
            "18.- R.F.C
            gs_salida-stcd1 = ls_kna1-stcd1.
            "19.- Nombre
            gs_salida-name1 = ls_kna1-name1.
            "20.- Pais
            gs_salida-land1 = ls_kna1-land1.
            "21.- Codigo Postal
            gs_salida-pstlz = ls_kna1-pstlz.
          ENDIF.
        ENDIF.
      ENDIF.
      "Campos Impuestos y retenciones
      CLEAR: lt_bset , lt_with_item.
      SELECT *
        FROM bset
          INTO TABLE lt_bset
            WHERE bukrs = gs_bseg-bukrs
              AND belnr = gs_bseg-belnr
              AND gjahr = gs_bseg-gjahr.

      SELECT *
        FROM with_item
          INTO TABLE lt_with_item
            WHERE bukrs = gs_bseg-bukrs
              AND belnr = gs_bseg-belnr
              AND gjahr = gs_bseg-gjahr.


      LOOP AT gt_bseg INTO ls_bseg WHERE bukrs = gs_bseg-bukrs
                                         AND belnr = gs_bseg-belnr
                                         AND gjahr = gs_bseg-gjahr
                                         AND koart = 'S'
                                         AND xauto <> 'X'.
        "6.- Importe MD
        gs_salida-wrbtr = ls_bseg-wrbtr.
        "8.- Importe ML
        gs_salida-dmbtr = ls_bseg-dmbtr.
        "22.- Cuenta contable
        gs_salida-hkont = ls_bseg-hkont.
        "24.- Ceco
        gs_salida-kostl = ls_bseg-kostl.
      ENDLOOP.
      IF lt_bset IS NOT INITIAL AND lt_with_item IS NOT INITIAL.
        LOOP AT lt_bset INTO ls_bset.
          "9.- Indicador IVA
          gs_salida-mwskz = ls_bset-mwskz.
          "10.- Importe IVA
          gs_salida-fwste = ls_bset-fwste.
          "23.- Cuenta Contable IVA
          gs_salida-hkont_i = ls_bset-hkont.

          LOOP AT lt_with_item INTO ls_with_item..
            "11.- Retenciones
            gs_salida-wt_qbshb = ls_with_item-wt_qbshb.
            APPEND gs_salida TO gt_salida.
          ENDLOOP.

        ENDLOOP.
      ELSEIF lt_bset IS NOT INITIAL AND lt_with_item IS INITIAL.
        LOOP AT lt_bset INTO ls_bset.
          "9.- Indicador IVA
          gs_salida-mwskz = ls_bset-mwskz.
          "10.- Importe IVA
          gs_salida-fwste = ls_bset-fwste.
          "23.- Cuenta Contable IVA
          gs_salida-hkont_i = ls_bset-hkont.

          APPEND gs_salida TO gt_salida.
        ENDLOOP.
      ELSEIF lt_bset IS INITIAL AND lt_with_item IS NOT INITIAL.
        LOOP AT lt_with_item INTO ls_with_item..
          "11.- Retenciones
          gs_salida-wt_qbshb = ls_with_item-wt_qbshb.
          APPEND gs_salida TO gt_salida.
        ENDLOOP.
      ELSE.
        APPEND gs_salida TO gt_salida.
      ENDIF.
    ENDIF.
  ENDLOOP.

  SORT gt_salida BY bldat budat belnr.
ENDFORM.                    " ARMA_SALIDA
