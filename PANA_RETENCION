form %newline.

data: %llen type i.
  %llen = 238.
  %uflag = space.
  new-line.
  write: '|', 238 '|'.
  position 2.

endform.

form %skip using count.

  if sy-linno > 1.
    %uflag = space.
    do count times.
      new-line.
      format reset.
      write: '|', 238 '|'.
    enddo.
  endif.

endform.

form %uline.

  if %uflag = space.
    if sy-linno > 1.
      uline /1(238).
    endif.
    %uflag = 'X'.
  endif.

endform.

form %hide.

  if %batch <> space and %diact = 'S'.
    perform hide(rsaqexce).
  else.
    hide: %tab, %line, %cont.
  endif.

endform.

form %hide_color.

