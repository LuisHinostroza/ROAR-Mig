select BELNR BUKRS BUZEI GJAHR WITHT WT_ACCO WT_QBSHB WT_QBSHH WT_QSSHH WT_WITHCD
       into corresponding fields of WITH_ITEM
       from WITH_ITEM
       where BELNR in SP$00003
         and BUKRS in SP$00001
         and GJAHR in SP$00002
         and WITHT in SP$00004
         and WT_ACCO in SP$00006
         and WT_WITHCD in SP$00005.
  %dbacc = %dbacc - 1.
  if %dbacc = 0.
    stop.
  endif.
  if BKPF-BUKRS <> WITH_ITEM-BUKRS
     or BKPF-BELNR <> WITH_ITEM-BELNR
     or BKPF-GJAHR <> WITH_ITEM-GJAHR.
    select single BELNR BLART BLDAT BUDAT BUKRS GJAHR KURSF MONAT STBLG WAERS XBLNR
                  into corresponding fields of BKPF
                  from BKPF
            where BUKRS = WITH_ITEM-BUKRS
              and BELNR = WITH_ITEM-BELNR
              and GJAHR = WITH_ITEM-GJAHR.
    if sy-subrc <> 0.
      clear BKPF.
      BKPF-BUKRS = WITH_ITEM-BUKRS.
      BKPF-BELNR = WITH_ITEM-BELNR.
      BKPF-GJAHR = WITH_ITEM-GJAHR.
    endif.
  endif.
  check SP$00008.
  check SP$00007.
  check SP$00009.
  if LFA1-LIFNR <> WITH_ITEM-WT_ACCO.
    select single KTOKK LAND1 LIFNR NAME1 STCD1
                  into corresponding fields of LFA1
                  from LFA1
            where LIFNR = WITH_ITEM-WT_ACCO.
    if sy-subrc <> 0.
      clear LFA1.
      LFA1-LIFNR = WITH_ITEM-WT_ACCO.
    endif.
  endif.
  if BSET-BUKRS <> WITH_ITEM-BUKRS
     or BSET-BELNR <> WITH_ITEM-BELNR
     or BSET-GJAHR <> WITH_ITEM-GJAHR
     or BSET-BUZEI <> WITH_ITEM-BUZEI.
    select single BELNR BUKRS BUZEI GJAHR MWSKZ
                  into corresponding fields of BSET
                  from BSET
            where BUKRS = WITH_ITEM-BUKRS
              and BELNR = WITH_ITEM-BELNR
              and GJAHR = WITH_ITEM-GJAHR
              and BUZEI = WITH_ITEM-BUZEI.
    if sy-subrc <> 0.
      clear BSET.
      BSET-BUKRS = WITH_ITEM-BUKRS.
      BSET-BELNR = WITH_ITEM-BELNR.
      BSET-GJAHR = WITH_ITEM-GJAHR.
      BSET-BUZEI = WITH_ITEM-BUZEI.
    endif.
  endif.
  if BSEG-BUKRS <> WITH_ITEM-BUKRS
     or BSEG-BELNR <> WITH_ITEM-BELNR
     or BSEG-GJAHR <> WITH_ITEM-GJAHR
     or BSEG-BUZEI <> WITH_ITEM-BUZEI.
    select single BELNR BUKRS BUZEI DMBTR GJAHR SGTXT WRBTR
                  into corresponding fields of BSEG
                  from BSEG
            where BUKRS = WITH_ITEM-BUKRS
              and BELNR = WITH_ITEM-BELNR
              and GJAHR = WITH_ITEM-GJAHR
              and BUZEI = WITH_ITEM-BUZEI.
    if sy-subrc <> 0.
      clear BSEG.
      BSEG-BUKRS = WITH_ITEM-BUKRS.
      BSEG-BELNR = WITH_ITEM-BELNR.
      BSEG-GJAHR = WITH_ITEM-GJAHR.
      BSEG-BUZEI = WITH_ITEM-BUZEI.
    endif.
  endif.
  Z_SUMA_ML = BSEG-DMBTR + ( WITH_ITEM-WT_QBSHH * -1 ) .
  Z_SUMA_MD = BSEG-WRBTR + ( WITH_ITEM-WT_QBSHB * -1 ) .
*IF BKPF-BLART EQ 'XK' AND BSET-MWSKZ EQ 'P1' AND
*  WITH_ITEM-WITHT EQ 'RE' AND WITH_ITEM-WT_WITHCD EQ '01' .
*  Z_SUMA_MD = BSEG-WRBTR.
*ELSEIF ( BKPF-BLART EQ 'SA' AND BKPF-BLART EQ 'KR' ) AND
*    WITH_ITEM-WITHT EQ 'RE' AND WITH_ITEM-WT_WITHCD EQ '01'.
*  Z_SUMA_MD = BSEG-WRBTR + ( WITH_ITEM-WT_QBSHB * -1 ) .
*ELSEIF ( BKPF-BLART EQ 'XK' AND BKPF-BLART EQ 'KR' ) AND
*    WITH_ITEM-WITHT EQ 'RE' AND WITH_ITEM-WT_WITHCD EQ '01'.
*ENDIF.
  add 1 to %count-WITH_ITEM.
  %linr-WITH_ITEM = '01'.
  extract %fg01.
  %ext-WITH_ITEM01 = 'X'.
    extract %fgwrWITH_ITEM01.
endselect.

