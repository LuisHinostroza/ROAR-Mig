  as select from ZI_LP_ListadoPagos
{
      // Fecha ejec. programa (LDB PYF) - única obligatoria
      @Consumption.filter: { mandatory: true, selectionType: #INTERVAL, multipleSelections: false }
  key PaymentRunDate,
      // Característica identificación (LDB PYF)
  key PaymentRunId,
  key IsProposalRun,
      // Sociedad pagadora - opcional, la corrida ya acota las sociedades
      @Consumption.valueHelpDefinition: [{ entity: { name: 'I_CompanyCodeStdVH', element: 'CompanyCode' } }]
  key PayingCompanyCode,
      @Consumption.valueHelpDefinition: [{ entity: { name: 'I_Supplier_VH', element: 'Supplier' } }]
  key Supplier,
  key Customer,
  key PayeeCode,
  key PaymentDocument,
      // Sociedad emisora (REGUP-BUKRS)
      @Consumption.valueHelpDefinition: [{ entity: { name: 'I_CompanyCodeStdVH', element: 'CompanyCode' } }]
  key CompanyCode,
  key AccountingDocument,
  key FiscalYear,
  key AccountingDocumentItem,

      PaymentReference,
      Name1,
      Street,
      TaxNumber1,
      PayeeName,
      PaymentMethod,

      @Semantics.amount.currencyCode: 'DocumentCurrency'
      @Aggregation.default: #SUM
      AmountInDocCurrency,
      DocumentCurrency,
      PaymentCurrency,

      ItemText,
      AssignmentReference,
      PostingDate,
      DocumentReference,
      City,
      BankKey,
      DocumentDate,
      DebitCreditCode,
      AccountHolder,
      BankAccount,
      Region
}
