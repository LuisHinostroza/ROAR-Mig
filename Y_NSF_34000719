Paso 3. Composite: ZI_LP_ListadoPagos
abap
@AccessControl.authorizationCheck: #NOT_REQUIRED
@EndUserText.label: 'Listado de pagos - Composite'
@ObjectModel.usageType: {
  serviceQuality: #C,
  sizeCategory:   #XL,
  dataClass:      #TRANSACTIONAL
}
define view entity ZI_LP_ListadoPagos
  as select from ZI_LP_PagoPos as Pos
    inner join   ZI_LP_PagoCab as Cab on  Cab.PaymentRunDate    = Pos.PaymentRunDate
                                      and Cab.PaymentRunId      = Pos.PaymentRunId
                                      and Cab.IsProposalRun     = Pos.IsProposalRun
                                      and Cab.PayingCompanyCode = Pos.PayingCompanyCode
                                      and Cab.Supplier          = Pos.Supplier
                                      and Cab.Customer          = Pos.Customer
                                      and Cab.PayeeCode         = Pos.PayeeCode
                                      and Cab.PaymentDocument   = Pos.PaymentDocument
{
  key Pos.PaymentRunDate,
  key Pos.PaymentRunId,
  key Pos.IsProposalRun,
  key Pos.PayingCompanyCode,
  key Pos.Supplier,
  key Pos.Customer,
  key Pos.PayeeCode,
  key Pos.PaymentDocument,
  key Pos.CompanyCode,
  key Pos.AccountingDocument,
  key Pos.FiscalYear,
  key Pos.AccountingDocumentItem,

      // Datos de pago (REGUH)
      Cab.PaymentReference,
      Cab.Name1,
      Cab.Street,
      Cab.TaxNumber1,
      Cab.PayeeName,
      Cab.City,
      Cab.BankKey,
      Cab.AccountHolder,
      Cab.BankAccount,
      Cab.Region,
      Cab.PaymentCurrency,

      // Posiciones tratadas (REGUP)
      Pos.PaymentMethod,
      @Semantics.amount.currencyCode: 'DocumentCurrency'
      Pos.AmountInDocCurrency,
      Pos.DocumentCurrency,
      Pos.ItemText,
      Pos.AssignmentReference,
      Pos.PostingDate,
      Pos.DocumentReference,
      Pos.DocumentDate,
      Pos.DebitCreditCode
}
// Solo ejecuciones productivas: equivale a "Sólo ejecución de propuesta" desmarcado
where Pos.IsProposalRun = ''
