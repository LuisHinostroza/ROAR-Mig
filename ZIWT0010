*       Reads CPD data
*----------------------------------------------------------------------*
FORM GET_CPD.

  IF BSIK-XCPDD EQ ' '.
    MOVE BSIK-LIFNR TO LIEFER.
  ELSE.
    SELECT SINGLE * FROM BSEC
     WHERE BUKRS EQ BSIK-BUKRS
     AND   BELNR EQ BSIK-BELNR
     AND   GJAHR EQ BSIK-GJAHR
     AND   BUZEI EQ BSIK-BUZEI.
    MOVE BSIK-LIFNR TO LIEFER+0(10).
    MOVE BSEC-NAME1 TO LIEFER+10(10).
    MOVE BSEC-STRAS TO LIEFER+20(8).
    MOVE BSEC-PSTLZ TO LIEFER+28(7).
    MOVE BSEC-NAME1 TO WNAME1.
    MOVE BSEC-STRAS TO WSTRAS.
    MOVE BSEC-PSTLZ TO WPSTLZ.
    MOVE BSEC-ORT01 TO WORT01.
    MOVE BSEC-STCD1 TO WSTCD1.
  ENDIF.

ENDFORM.
