*----------------------------------------------------------------------*
*       FORM CONVERT-CURRENCY                                          *
*----------------------------------------------------------------------*
*       Umrechnung Belegwährung in Hauswährung für IT, ES, GB, AU      *
*----------------------------------------------------------------------*
FORM convert-currency.
  IF bsik-augdt NE '00000000'.
    CALL FUNCTION 'CONVERT_TO_LOCAL_CURRENCY'
      EXPORTING
        date             = bsik-augdt
        foreign_amount   = wwrbtr          "Rechn.btr in BW
        foreign_currency = bsik-waers
        local_currency   = waers
      IMPORTING
        local_amount     = ktab-wdmbtr.
  ELSE.
    ktab-wdmbtr = wdmbtr.
  ENDIF.
  IF wwrbtr <> 0.
    ktab-wqsshb = wqsshb * ktab-wdmbtr / wwrbtr.    "Qst.-Basis
    ktab-wqbshb = wqbshb * ktab-wdmbtr / wwrbtr.    "Qst-Betrag
  ELSE.
    ktab-wqsshb = 0.
    ktab-wqbshb = 0.
  ENDIF.
  ktab-netto = ktab-wdmbtr - ktab-wqbshb.
  ktab-wqsfbt = ktab-wdmbtr - ktab-wqsshb.
ENDFORM.

