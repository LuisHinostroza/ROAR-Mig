*&---------------------------------------------------------------------*
*&    Form GET_LOCAL_AMOUNTS
*&---------------------------------------------------------------------*
* WT base and WT amount in local
* currency. Only used when doc. posted in foreign currency.
* If flag umrechn = 'X' exchange rate is taken at invoice date
* otherwise it's taken at payment date.
*----------------------------------------------------------------------*
FORM GET_LOCAL_AMOUNTS
     USING    VALUE(LOC_BUKRS)
              VALUE(LOC_BELNR)
              VALUE(LOC_AUGBL)
              VALUE(LOC_AUGDT)
              VALUE(LOC_GJAHR)
              VALUE(LOC_WRBTR)
              VALUE(LOC_WAERS)
              VALUE(LOC_UMRECHN)
*   changing
              LOC_DMBTR
              LOC_QSSHB
              LOC_QBSHB.

  DATA: BEGIN OF BKOPF.
          INCLUDE STRUCTURE BKPF.
  DATA: END OF BKOPF.
  DATA: AUG_YEAR   LIKE BKPF-GJAHR,
        CONV_DATE  LIKE BKPF-WWERT,
        CURR_QSSHB LIKE BSIK-WAERS,
        CURR_QBSHB LIKE BSIK-WAERS,
        RATE_QSSHB LIKE BKPF-KURSF,
        RATE_QBSHB LIKE BKPF-KURSF.

  IF LOC_AUGBL IS INITIAL
     OR LOC_AUGDT EQ '00000000'.             " Document is not cleared
     IF LOC_WRBTR <> 0.
       LOC_QSSHB = LOC_QSSHB * LOC_DMBTR / LOC_WRBTR.
                                " Withholding tax base in local currency
       LOC_QBSHB = LOC_QBSHB * LOC_DMBTR / LOC_WRBTR.
                                " Withholding tax in local currency
     ELSE.
       LOC_QSSHB = 0.
       LOC_QBSHB = 0.
     ENDIF.

  ELSE.                                        " Document is cleared
*   Document header data from invoice and payment document.
    CALL FUNCTION 'GET_CURRENT_YEAR'       " Data from payment document
         EXPORTING
           BUKRS = LOC_BUKRS
           DATE  = LOC_AUGDT
         IMPORTING
           CURRY = AUG_YEAR.
    SELECT SINGLE * FROM BKPF INTO BKOPF
       WHERE BUKRS = LOC_BUKRS
       AND   BELNR = LOC_AUGBL
       AND   GJAHR = AUG_YEAR.

    SELECT SINGLE * FROM BKPF              " Data from invoice document
      WHERE BUKRS = LOC_BUKRS
      AND   BELNR = LOC_BELNR
      AND   GJAHR = LOC_GJAHR.

    IF LOC_UMRECHN = ' '.         " Exchange rate taken at payment date
      CONV_DATE  = BKOPF-WWERT.
    ELSE.                         " Exchange rate taken at invoice date
      CONV_DATE  = BKPF-WWERT.
    ENDIF.
    CURR_QSSHB = BKPF-WAERS.
    RATE_QSSHB = BKPF-KURSF.
    CURR_QBSHB = BKOPF-WAERS.
    RATE_QBSHB = BKOPF-KURSF.
*-------- calculate invoice amount in loc. currency, for calculation of
*-------- tax free amount and netto amount
    CALL FUNCTION 'CONVERT_TO_LOCAL_CURRENCY'
      EXPORTING   DATE             = CONV_DATE
                  FOREIGN_CURRENCY = CURR_QSSHB
                  LOCAL_CURRENCY   = LOC_WAERS
                  FOREIGN_AMOUNT   = LOC_WRBTR
*                  rate             = rate_qsshb
                  TYPE_OF_RATE     = 'M'
      IMPORTING   LOCAL_AMOUNT     = LOC_DMBTR.
*----------------------------------- calculate WT base in loc. currency
    CALL FUNCTION 'CONVERT_TO_LOCAL_CURRENCY'
      EXPORTING   DATE             = CONV_DATE
                  FOREIGN_CURRENCY = CURR_QSSHB
                  LOCAL_CURRENCY   = LOC_WAERS
                  FOREIGN_AMOUNT   = LOC_QSSHB
*                  rate             = rate_qsshb
                  TYPE_OF_RATE     = 'M'
      IMPORTING   LOCAL_AMOUNT     = LOC_QSSHB.
*--------------------------------- calculate WT amount in loc. currency
    CALL FUNCTION 'CONVERT_TO_LOCAL_CURRENCY'
      EXPORTING   DATE             = CONV_DATE
                  FOREIGN_CURRENCY = CURR_QBSHB
                  LOCAL_CURRENCY   = LOC_WAERS
                  FOREIGN_AMOUNT   = LOC_QBSHB
*                  rate             = rate_qbshb
                  TYPE_OF_RATE     = 'M'
      IMPORTING   LOCAL_AMOUNT     = LOC_QBSHB.
  ENDIF.
ENDFORM.                                          " GET_LOCAL_AMOUNTS

*&---------------------------------------------------------------------*
*&    Form GET_CURR_EXCHANGE_DATA
*&---------------------------------------------------------------------*
* Determines currency exchange data for exchange into local currency:
*    exchange date,
*    currency of invoice,
*    exchange rate of invoice (if given by hand),
*    currency of payment,
*    exchange rate of payment (if given by hand)
*----------------------------------------------------------------------*
FORM GET_CURR_EXCHANGE_DATA
     USING    VALUE(I_BUKRS)
              VALUE(I_BELNR)
              VALUE(I_AUGBL)
              VALUE(I_AUGDT)
              VALUE(I_GJAHR)
*   changing
              I_INV_DATE
              I_CURR_INV
              I_RATE_INV
              I_PAY_DATE
              I_CURR_PAY
              I_RATE_PAY.

  DATA: AUG_YEAR LIKE BKPF-GJAHR.
  DATA: BEGIN OF BKOPF.
          INCLUDE STRUCTURE BKPF.
  DATA: END OF BKOPF.

  SELECT SINGLE * FROM BKPF INTO BKOPF     " Data from invoice document
    WHERE BUKRS = I_BUKRS
    AND   BELNR = I_BELNR
    AND   GJAHR = I_GJAHR.

  IF NOT I_AUGBL IS INITIAL
  OR NOT I_AUGDT EQ '00000000'.                   " Document is cleared

    CALL FUNCTION 'GET_CURRENT_YEAR'       " Data from payment document
         EXPORTING
           BUKRS = I_BUKRS
           DATE  = I_AUGDT
         IMPORTING
           CURRY = AUG_YEAR.

    SELECT SINGLE * FROM BKPF
      WHERE BUKRS = I_BUKRS
      AND   BELNR = I_AUGBL
      AND   GJAHR = AUG_YEAR.

    I_INV_DATE  = BKOPF-WWERT.
    I_CURR_INV = BKOPF-WAERS.
    I_RATE_INV = BKOPF-KURSF.
    I_PAY_DATE  = BKPF-WWERT.
    I_CURR_PAY = BKPF-WAERS.
    I_RATE_PAY = BKPF-KURSF.

  ELSE.                                        "Document is not cleared

    I_INV_DATE = BKOPF-WWERT.
    I_CURR_INV = BKOPF-WAERS.
    I_RATE_INV = BKOPF-KURSF.
    I_PAY_DATE = I_INV_DATE.
    I_CURR_PAY = I_CURR_INV.
    I_RATE_PAY = I_RATE_INV.
  ENDIF.

ENDFORM.                                    " Of get_curr_exchange_data

*&---------------------------------------------------------------------*
*&    Form CONVERT_AMOUNT
*&---------------------------------------------------------------------*
* WT base and WT amount in local
* currency. Only used when doc. posted in foreign currency.
* If flag umrechn = 'X' exchange rate is taken at invoice date
* otherwise it's taken at payment date.
*----------------------------------------------------------------------*
FORM CONVERT_AMOUNT
     USING    VALUE(I_AUGBL)
              VALUE(I_AUGDT)
              VALUE(I_WRBTR)
              VALUE(I_DMBTR)
              VALUE(I_FROM_CURR)
              VALUE(I_TO_CURR)
              VALUE(I_CONV_DATE)
              VALUE(I_RATE)
*   changing
              I_AMOUNT.

  IF I_AUGBL IS INITIAL
  OR I_AUGDT EQ '00000000'.                   " Document is not cleared
     IF I_WRBTR <> 0.
       I_AMOUNT = I_AMOUNT * I_DMBTR / I_WRBTR.
     ELSE.
       I_AMOUNT = 0.
     ENDIF.

  ELSE.                                           " Document is cleared

    CALL FUNCTION 'CONVERT_TO_LOCAL_CURRENCY'
      EXPORTING   DATE             = I_CONV_DATE
                  FOREIGN_CURRENCY = I_FROM_CURR
                  LOCAL_CURRENCY   = I_TO_CURR
                  FOREIGN_AMOUNT   = I_AMOUNT
*                 rate             = i_rate
                  TYPE_OF_RATE     = 'M'
      IMPORTING   LOCAL_AMOUNT     = I_AMOUNT.
  ENDIF.

ENDFORM.                                            " Of CONVERT_AMOUNT

