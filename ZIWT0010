      ELSEIF old_with = 'X'.                   " Insert 140321
        SELECT SINGLE * FROM t059q               " Insert 140321
        WHERE land1 EQ t001-land1                " Insert 140321
   AND   qsskz EQ ktab-qsskz.                    " Insert 140321
        IF sy-subrc = 0.                         " Insert 140321
          lv_qscod = t059q-qscod.               " Insert 140321
        ELSE.                                    " Insert 140321
