    ENDAT.

    count2 = count2 + 1.
    IF einzelpo EQ 'X'.
      FORMAT COLOR COL_NORMAL INTENSIFIED OFF.
      WRITE: /2 ktab-budat DDMMYY,
               ktab-belnr,
               ktab-bldat DDMMYY,
               ktab-xblnr,
               ktab-augdt DDMMYY,
               ktab-qsskz,
*              t059q-qscod,         " Delete 140321
               lv_qscod,            " Insert 140321
               (14)ktab-wdmbtr CURRENCY outputwaers,
               (14)ktab-wqsshb CURRENCY outputwaers,
               (14)ktab-wqbshb CURRENCY outputwaers,
               (14)ktab-netto  CURRENCY outputwaers,
               (13)ktab-wqsfbt CURRENCY outputwaers.
