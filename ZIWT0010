*---------------------------------------------------------------------*
*       FORM COLOMBIA                                                 *
*---------------------------------------------------------------------*
*       QUELLENSTEURREPORT FÜR COLOMBIA                               *
*---------------------------------------------------------------------*
FORM colombia.
  LOOP.
    AT NEW bsik-bukrs.
      h_zaehl = p_zaehl.
      SELECT SINGLE * FROM t001
        WHERE bukrs EQ bsik-bukrs.
      MOVE bsik-bukrs TO bhdgd-bukrs.
      MOVE bhdgd-bukrs TO bhdgd-werte.
      MOVE t001-waers TO waers.

*-------  Euro                                                  -------
      IF altcurr NE space.
        outputwaers = altcurr.
      ELSE.
        outputwaers = waers.
      ENDIF.

      PERFORM new-section(rsbtchh0).
      flag1 = 0.
      flag3 = 0.
      REFRESH etab.
      REFRESH stab.
    ENDAT.

    AT NEW liefer.
      UNPACK h_zaehl TO lfdnum.
      IF bsik-xcpdd NE 'X'.
        SELECT SINGLE * FROM lfa1
         WHERE lifnr EQ bsik-lifnr.
        MOVE: lfa1-name1 TO adress-name1,
              lfa1-stras TO adress-stras,
              lfa1-pstlz TO adress-pstlz,
              lfa1-ort01 TO adress-ort01.
      ELSE.
        MOVE: wname1 TO adress-name1,
              wstras TO adress-stras,
              wpstlz TO adress-pstlz,
              wort01 TO adress-ort01.
        MOVE  wstcd1 TO lfa1-stcd1.                        "INSERT65219
      ENDIF.
      RESERVE 4 LINES.
***
      IF sy-linno > toplength.
        SKIP.
        PERFORM adresseitalia.
      ENDIF.
      h_zaehl  = h_zaehl + 1.
      REFRESH ktab.
    ENDAT.

    AT daten.
      IF NOT new_with IS INITIAL AND
         NOT e_witht IS INITIAL.
        ktab-witht = e_witht.
      ENDIF.
      ktab-qsskz = bsik-qsskz.
      ktab-budat = bsik-budat.
      ktab-xblnr = bsik-xblnr.
      ktab-belnr = bsik-belnr.
      ktab-bschl = bsik-bschl.
      ktab-buzei = bsik-buzei.
      ktab-blart = bsik-blart.
      ktab-bldat = bsik-bldat.
      ktab-augdt = bsik-augdt.
*     if bsik-waers eq waers.
      ktab-wdmbtr = wdmbtr.
      ktab-wqsshb = wqsshb.
      ktab-wqbshb = wqbshb.
      ktab-netto = netto.
      ktab-wqsfbt = wqsfbt.
*     else.
*       perform convert-currency.
*     endif.
      APPEND ktab.
    ENDAT.

    AT END OF liefer.
      count3 = 0.
      IF qstsumme EQ 'X'
        OR einzelpo EQ 'X'
        OR ktosumme EQ 'X'
        OR summentb EQ 'X'.
        PERFORM printitalia.
      ENDIF.
    ENDAT.

    AT END OF bsik-bukrs.
      IF bkrsumme = 'X'.
        RESERVE 2 LINES.
        READ TABLE stab INDEX 1.
        FORMAT COLOR COL_TOTAL INTENSIFIED.
        WRITE: / TEXT-003,
                  bsik-bukrs,
               51 '** ****',
               (14)stab-wdmbtr CURRENCY outputwaers,
               (14)stab-wqsshb CURRENCY outputwaers,
               (14)stab-wqbshb CURRENCY outputwaers,
               (14)stab-netto  CURRENCY outputwaers,
               (13)stab-wqsfbt CURRENCY outputwaers.
        WRITE: 1(1) sy-vline.
        PERFORM fill_vline_ita.
        WRITE: /1(132) sy-uline.
        FORMAT COLOR OFF.
      ENDIF.
      IF summentb EQ 'X' AND flag3 EQ 1.
        flag1 = 1.
        PERFORM sumtabitalia.
      ENDIF.
      NEW-PAGE.
    ENDAT.

  ENDLOOP.

  DESCRIBE TABLE ktab LINES h_lines.
  IF h_lines EQ 0.
    CALL FUNCTION 'POPUP_NO_LIST'
      EXPORTING
        on_empty_list = 'X'.
  ENDIF.

ENDFORM.

