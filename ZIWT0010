*        Classical or old withholding tax
    IF old_with = 'X'.
      SELECT SINGLE * FROM t059q
        WHERE land1 EQ t001-land1
          AND qsskz EQ etab-qsskz.
      IF sy-subrc = 0.
        lv_qscod = t059q-qscod.
        lv_qsbez = t059q-qsbez.
      ELSE.
        CLEAR:
         lv_qscod,
         lv_qsbez.
      ENDIF.

*        extended withholding tax
    ELSEIF new_with = 'X' AND
           NOT etab-witht IS INITIAL.
* Read information about WT code of extended WT
      CALL FUNCTION 'FI_WT_READ_T059Z'
        EXPORTING
          i_bukrs     = t001-bukrs
