    AT END OF qsskz.
      SUM.
      IF summentb EQ 'X'.

        IF NOT ktab-witht IS INITIAL.                   " Insert 140321
          etab-witht = ktab-witht.                      " Insert 140321
        ELSE.                                           " Insert 140321
          CLEAR etab-witht.                             " Insert 140321
        ENDIF.                                        " Insert 140321

        etab-qsskz  = ktab-qsskz.
        etab-wdmbtr = ktab-wdmbtr.
        etab-wqsshb = ktab-wqsshb.
        etab-wqbshb = ktab-wqbshb.
        etab-netto  = ktab-netto.
        etab-wqsfbt = ktab-wqsfbt.
