            i_type      = ktab-witht                " Insert 140321
            i_wt_withcd = ktab-qsskz                " Insert 140321
          TABLES                                     " Insert 140321
            t_t059z     = x_t059z                   " Insert 140321
          EXCEPTIONS                              " Insert 140321
            not_found   = 4.                        " Insert 140321
        IF sy-subrc = 0.                        " Insert 140321
          lv_qscod = x_t059z-qscod.            " Insert 140321
        ELSE.
          CLEAR lv_qscod.                      " Insert 140321
          CLEAR x_t059z.                       " Insert 140321
        ENDIF.                                  " Insert 140321
        FORMAT COLOR OFF INTENSIFIED OFF.
        WRITE: /1 sy-vline(1),
                  TEXT-409 COLOR COL_POSITIVE,
                  sy-vline(1),
                  ktab-witht COLOR COL_POSITIVE,
                  sy-vline(1),
