*----------------------------------------------------------------------*
*                         Initialisierung                              *
*----------------------------------------------------------------------*
INITIALIZATION.
  GET_FRAME_TITLE: 1, 2.
  PERFORM PROPOSE_CURRENT_YEAR.


*----------------------------------------------------------------------*
*                          Header-Lines                                *
*----------------------------------------------------------------------*

TOP-OF-PAGE.
  CASE P_VARIA.
    WHEN 'IT'.
      PERFORM TOP-ITALIA.
    WHEN 'ES'.
      PERFORM TOP-ITALIA.
    WHEN 'FR'.
      PERFORM TOP-FRANCE.
    WHEN 'BE'.
      PERFORM TOP-FRANCE.
    WHEN 'CZ'.
      PERFORM TOP-ITALIA.
    WHEN 'CO'.
      PERFORM TOP-ITALIA.
    WHEN 'MX'.
      PERFORM TOP-ITALIA.
  ENDCASE.

*----------------------------------------------------------------------*
*                         Checks at Selection Screen                   *
*----------------------------------------------------------------------*

AT SELECTION-SCREEN ON P_VARIA.

* Check whether the choosen country variant is supported by the report.
  IF P_VARIA NE 'IT'
    AND P_VARIA NE 'FR'
    AND P_VARIA NE 'BE'
    AND P_VARIA NE 'ES'
    AND P_VARIA NE 'CZ'
    AND P_VARIA NE 'MX'
    AND P_VARIA NE 'CO'.
    MESSAGE E152.
  ENDIF.

  IF P_VARIA NE 'IT'
    AND P_VARIA NE 'ES'
    AND P_VARIA NE 'CZ'.
    MOVE 80 TO SYST-LINSZ.
  ENDIF.

* Czechia requires conversion of foreign curr. at invoice date
  IF P_VARIA = 'CZ'.
    UMRECHN = 'X'.
  ENDIF.

** Determines the correct country form
*  CASE P_VARIA.
*    WHEN 'IT' OR 'ES' OR 'CZ'.
*      P_FORID = 'I '.
*    WHEN 'BE'.
*      P_FORID = 'B '.
*    WHEN 'FR'.
*      P_FORID = 'F '.
*    WHEN 'MX'.
*      P_FORID = 'M '.
*    WHEN 'CO'.
*      P_FORID = 'C '.
*  ENDCASE.

* Old or new WT functionality?
AT SELECTION-SCREEN ON KD_BUKRS.

  PERFORM CHECK_COMPANY_CODES.

* New WT functionality: WT types
AT SELECTION-SCREEN ON WITHT.

  PERFORM CHECK_WT_TYPES. "Are choosen WT types defined in table T059P?

* WT codes
AT SELECTION-SCREEN ON QSTKZ.

  IF QSTKZ NE SPACE AND OLD_WITH = 'X'.          " Old WT functionality
    PERFORM CHECK_OLD_WT_CODES.
  ENDIF.

  IF QSTKZ NE SPACE AND NEW_WITH = 'X'.          " New WT functionality
    PERFORM CHECK_WT_CODES.
    QSTKZ_EXT   = QSTKZ.
    QSTKZ_EXT[] = QSTKZ[].
  ENDIF.

*------- Alternative local currency (Euro)                       -------
AT SELECTION-SCREEN ON CONVDAT.

  IF NOT ALTCURR IS INITIAL AND CONVDAT IS INITIAL.
    CONVDAT = SY-DATUM.
  ENDIF.

* ---------------------------------------------------------------------
AT SELECTION-SCREEN.

* In case of immediately printing: Is printer specified?
  IF P_IMMEA = 'X'
    AND P_PRINT EQ SPACE.
    MESSAGE E277.
  ENDIF.

** Determines country specific printing form
*  SELECT SINGLE * FROM  T001F
*         WHERE  BUKRS       = '    '
*         AND    PROGRAMM    = SY-REPID
*         AND    EVENT       = P_FORID
*         AND    KOART       = ' '.
*
*  IF SY-SUBRC NE 0.
*    SELECT        * FROM  T001
*           WHERE  BUKRS       IN KD_BUKRS.
*      SELECT SINGLE * FROM  T001F
*             WHERE  BUKRS       = T001-BUKRS
*             AND    PROGRAMM    = SY-REPID
*             AND    EVENT       = P_FORID
*             AND    KOART       = ' '.
*      IF SY-SUBRC NE 0.
*        MESSAGE E276 WITH T001-BUKRS SY-REPID P_FORID.
*      ENDIF.
*    ENDSELECT.
*  ENDIF.
*
** Determines Adress ID
*  SELECT SINGLE * FROM  T001G
*         WHERE  BUKRS       = '    '
*         AND    PROGRAMM    = SY-REPID
*         AND    TXTID       = P_ADRID.
*  IF SY-SUBRC NE 0.
*    SELECT        * FROM  T001
*           WHERE  BUKRS       IN KD_BUKRS.
*      SELECT SINGLE * FROM  T001G
*             WHERE  BUKRS       = T001-BUKRS
*             AND    PROGRAMM    = SY-REPID
*             AND    TXTID       = P_ADRID.
*      IF SY-SUBRC NE 0.
*        FLAG6 = 'X'.
*      ENDIF.
*    ENDSELECT.
*    IF FLAG6 = 'X'.
*      MESSAGE W275.
*    ENDIF.
*  ENDIF.

* Configuration of country specific header line
  MOVE TEXT-400 TO WTITLE.
  IF ALT_CTRY IS INITIAL.
    CASE P_VARIA.
      WHEN 'IT'.
        REPLACE '$' WITH TEXT-401 INTO WTITLE.
      WHEN 'FR'.
        REPLACE '$' WITH TEXT-403 INTO WTITLE.
      WHEN 'BE'.
        REPLACE '$' WITH TEXT-404 INTO WTITLE.
      WHEN 'ES'.
        REPLACE '$' WITH TEXT-402 INTO WTITLE.
      WHEN 'CZ'.
        REPLACE '$' WITH TEXT-407 INTO WTITLE.
      WHEN 'MX'.
        REPLACE '$' WITH TEXT-409 INTO WTITLE.
      WHEN 'CO'.
        REPLACE '$' WITH TEXT-410 INTO WTITLE.
    ENDCASE.
  ELSE.
    REPLACE '$' WITH ALT_CTRY INTO WTITLE.
  ENDIF.

  CASE P_VARIA.
    WHEN 'IT'.
      TOPLENGTH = 11.
    WHEN 'ES'.
      TOPLENGTH = 10.
    WHEN 'FR'.
      TOPLENGTH = 11.
    WHEN 'BE'.
      TOPLENGTH = 11.
    WHEN 'CZ'.
      TOPLENGTH = 11.
    WHEN 'MX'.
      TOPLENGTH = 11.
    WHEN 'CO'.
      TOPLENGTH = 11.
  ENDCASE.

  IF   P_VARIA EQ 'FR'
    OR P_VARIA EQ 'BE'.
    MOVE '80' TO BHDGD-LINES.
  ELSEIF P_VARIA EQ 'IT'
    OR P_VARIA EQ 'ES'
    OR P_VARIA EQ 'CZ'
    OR P_VARIA EQ 'MX'
    OR P_VARIA EQ 'CO'.
    MOVE '132' TO BHDGD-LINES.
  ENDIF.

  MOVE '0' TO BHDGD-INIFL.
  MOVE SYST-UNAME   TO BHDGD-UNAME.
  MOVE SYST-REPID   TO BHDGD-REPID.
  MOVE P_ZUTIT      TO BHDGD-LINE2.
  MOVE WTITLE       TO BHDGD-LINE1.
  MOVE LISTSEPA     TO BHDGD-SEPAR.
  MOVE 'BSIK-BUKRS' TO BHDGD-DOMAI.

*---------- Define reporting period, printed in the sapscript form -----
*---------- Belgium: Only WT base is relevant => open items are selected
  IF P_VARIA EQ 'BE'.
    MOVE: BUCHDT-LOW  TO RFKHELP-VONDT,
          BUCHDT-HIGH TO RFKHELP-BISDT.
*---------- Other countries: WT has to be reported => clearing date
  ELSE.
    MOVE: AUGDAT-LOW  TO RFKHELP-VONDT,
          AUGDAT-HIGH TO RFKHELP-BISDT.
  ENDIF.

*---------- In Belgium open items have to be taken into account. -------
  IF P_VARIA = 'BE' AND UNAUSGEG NE 'X'.
    MESSAGE W385 WITH P_VARIA.
  ENDIF.

*---------- Information: Exchange rate taken at invoice time -----------
  IF UMRECHN = 'X'.
    MESSAGE I453.
  ENDIF.

*---------- Commands for printing --------------------------------------
  IF SY-BATCH = 'X'.
    NEW-PAGE
      NO-TITLE
      NO-HEADING
      PRINT ON
        DESTINATION P_PRINT
        IMMEDIATELY P_IMMEA
        KEEP IN SPOOL ' '
        COVER TEXT WTITLE
        LINE-SIZE '132'
        LINE-COUNT '65'
        NEW LIST IDENTIFICATION 'X'
        NO DIALOG.
  ELSE.
    NEW-PAGE
      NO-TITLE
      NO-HEADING
      PRINT ON
        DESTINATION P_PRINT
        IMMEDIATELY P_IMMEA
        KEEP IN SPOOL ' '
        COVER TEXT WTITLE
        LINE-SIZE '132'
        NEW LIST IDENTIFICATION 'X'
        NO DIALOG.
    NEW-PAGE PRINT OFF.
  ENDIF.

*----------------------------------------------------------------------*
*                                 Selection                            *
*----------------------------------------------------------------------*

START-OF-SELECTION.

  COMMIT WORK.                          "PERFORMANCE INFORMIX

*---------- Get relevant (xumsw = 'X') posting keys --------------------
  SELECT * FROM TBSL
   WHERE XUMSW = 'X'.
    BUSCHL-LOW = TBSL-BSCHL.
    BUSCHL-SIGN = 'I'.
    BUSCHL-OPTION = 'EQ'.
    APPEND BUSCHL.
  ENDSELECT.

  GET BSIK.

*------- In case of classical or old WT, exclude items without QSSKZ ---
  if old_with = 'X'.
    CHECK BSIK-QSSKZ NE SPACE.
  endif.

*----------- Exclude 'Merkposten' --------------------------------------
  CHECK BSIK-BSTAT NE 'S'.

*----------- Get company code data -------------------------------------
  IF BSIK-BUKRS NE T001-BUKRS.
    SELECT SINGLE * FROM T001
      WHERE BUKRS EQ BSIK-BUKRS.
  ENDIF.

*----------------------------------------------------------------------*
*                      New Withholding Tax                             *
*----------------------------------------------------------------------*
  IF NOT NEW_WITH IS INITIAL.

    CLEAR X_WITH_ITEM[].

*   Read WT data from with_item into x_with_item
    CALL FUNCTION 'FI_WT_READ_WT_INFO'
         EXPORTING
              I_BUKRS     = BSIK-BUKRS
              I_BELNR     = BSIK-BELNR
              I_GJAHR     = BSIK-GJAHR
              I_BUZEI     = BSIK-BUZEI  " Get WT data of complete doc.
         TABLES
              T_WITH_ITEM = X_WITH_ITEM
         EXCEPTIONS
              NOT_FOUND   = 1
              OTHERS      = 2.

    CLEAR: BSIK-QSSKZ.

*   For calculation of VAT tax we need WT data of the total document
    IF P_VARIA = 'CO' OR P_VARIA = 'MX'.
      SELECT * FROM WITH_ITEM INTO TABLE I_WITH_ITEM
                             WHERE BUKRS  = BSIK-BUKRS
                               AND BELNR  = BSIK-BELNR
                               AND GJAHR  = BSIK-GJAHR
                               AND BUZEI <> BSIK-BUZEI.
      LOOP AT I_WITH_ITEM.
        X_WITH_ITEM = I_WITH_ITEM.
        APPEND X_WITH_ITEM.
      ENDLOOP.
    ENDIF.

*   Determine total WT amount with posting at invoice time

*   In the case that there are WT types with posting at invoice, the
*   invoice amount in bsik (bsak) does not correspond to the total
*   amount but is reduced by the total WT amount of all types with
*   posting at invoice time. Thus, it is necessary first to loop over
*   the with_item and to detect and to sum up all WT amount of posting
*   at invoice types.
    PERFORM GET_TOTAL_WT_AT_INVOICE TABLES X_WITH_ITEM
                                           X_T059P
                                           X_WT_AT_INVOICE
                                     USING T001-LAND1.

*   Convert WT amounts into local curr. depending on spec. exchange date
    IF BSIK-WAERS NE T001-WAERS AND
       UMRECHN = 'X' AND
       BSIK-WRBTR NE 0.
      RATE = BSIK-DMBTR / BSIK-WRBTR.
      LOOP AT X_WT_AT_INVOICE.
        X_WT_AT_INVOICE-WT_QBSHH = X_WT_AT_INVOICE-WT_QBSHB * RATE.
        MODIFY X_WT_AT_INVOICE.
      ENDLOOP.
    ENDIF.

*  Proceed WT data of current vendor line
   LOOP AT X_WITH_ITEM WHERE BUZEI = BSIK-BUZEI.

     IF NOT QSTKZ_EXT IS INITIAL.
       CHECK X_WITH_ITEM-WT_WITHCD IN QSTKZ_EXT.
     ENDIF.

     IF NOT WITHT IS INITIAL.
       CHECK X_WITH_ITEM-WITHT IN WITHT.
     ENDIF.

*   Convert WT amounts into local curr. depending on spec. exchange date
    IF BSIK-WAERS NE T001-WAERS AND
       UMRECHN = 'X'            AND
       X_WITH_ITEM-WT_QSSHB NE 0.
             RATE = X_WITH_ITEM-WT_QSSHH / X_WITH_ITEM-WT_QSSHB.
             X_WITH_ITEM-WT_QBSHH = X_WITH_ITEM-WT_QBSHB * RATE.
    ELSEIF BSIK-WAERS NE T001-WAERS AND
           UMRECHN = ' '            AND
           X_WITH_ITEM-WT_QBSHB NE 0.
             RATE = X_WITH_ITEM-WT_QBSHH / X_WITH_ITEM-WT_QBSHB.
             X_WITH_ITEM-WT_QSSHH = X_WITH_ITEM-WT_QSSHB * RATE.
             BSIK-DMBTR = BSIK-WRBTR * RATE.
    ENDIF.

*   Add total WT at invoice to bsik-dmbtr to get total dmbtr
    READ TABLE X_WT_AT_INVOICE WITH KEY BUKRS = BSIK-BUKRS
                                        BELNR = BSIK-BELNR
                                        GJAHR = BSIK-GJAHR
                                        BUZEI = BSIK-BUZEI.
    IF X_WT_AT_INVOICE-WT_QBSHH < 0.
      X_WT_AT_INVOICE-WT_QBSHH = X_WT_AT_INVOICE-WT_QBSHH * -1.
    ENDIF.
    H_DMBTR = BSIK-DMBTR + X_WT_AT_INVOICE-WT_QBSHH.

*     Filling of data extract fields according to country specific
*     selection checks

*     Italy, Spain, Czechia, Colombia, Mexico
      IF   P_VARIA EQ 'IT'
        OR P_VARIA EQ 'ES'
        OR P_VARIA EQ 'CZ'.
        PERFORM PREP_DATA_EXTR_EXT_WT_CTRGR_1 CHANGING PROCESSING_FLAG.
      ENDIF.

*     France
      IF P_VARIA = 'FR'.
        PERFORM PREP_DATA_EXTR_EXT_WT_CTRGR_2 CHANGING PROCESSING_FLAG.
      ENDIF.

*     Belgium
      IF P_VARIA = 'BE'.
        PERFORM PREP_DATA_EXTR_EXT_WT_CTRGR_3 CHANGING PROCESSING_FLAG.
      ENDIF.

*     Colombia
      IF P_VARIA = 'CO' OR
         P_VARIA = 'MX'.
        PERFORM PREP_DATA_EXTR_EXT_WT_CTRGR_4 CHANGING PROCESSING_FLAG.
      ENDIF.

      IF PROCESSING_FLAG = 'X'.

*       Get CPD data from document
        PERFORM GET_CPD_DATA.

        BSIK-QSSKZ = X_WITH_ITEM-WT_WITHCD.
        E_WITHT    = X_WITH_ITEM-WITHT.

*       Convert amounts from local curr. into alternative local curr.
