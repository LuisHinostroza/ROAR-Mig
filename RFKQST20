*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM CONVERT_INTO_ALT_LOC_CURR.

        IF WDMBTR <> 0.
          H_WDMBTR = WDMBTR.
          CALL FUNCTION 'CONVERT_TO_FOREIGN_CURRENCY'
               EXPORTING DATE             = CONVDAT
                         FOREIGN_CURRENCY = ALTCURR
                         LOCAL_AMOUNT     = WDMBTR
                         LOCAL_CURRENCY   = T001-WAERS
*                         rate             = ???
                         TYPE_OF_RATE     = 'M'
               IMPORTING FOREIGN_AMOUNT   = WDMBTR.
          ALT_RATE = WDMBTR / H_WDMBTR.
          WQSSHB = ALT_RATE * WQSSHB.
