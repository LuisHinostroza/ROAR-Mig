          IF BSIK-AUGBL EQ SPACE.
            CHECK BUCHDT.
          ELSE.
            CHECK AUGDAT.
            CHECK BSIK-BUDAT LT AUGDAT-LOW.
          ENDIF.
        WHEN OTHERS.
          REJECT.
      ENDCASE.

      IF BSIK-SHKZG EQ 'H'
        OR  BSIK-UMSKS EQ 'A' AND BSIK-AUGBL EQ SPACE.
        WDMBTR = BSIK-DMBTR.
        WWRBTR = BSIK-WRBTR.
        WQSSHB = BSIK-QSSHB.
        WQBSHB = BSIK-QBSHB.
        WQSFBT = WDMBTR - WQSSHB.
        NETTO  = WDMBTR - WQBSHB.
      ELSE.
        WDMBTR = BSIK-DMBTR * -1.
        WWRBTR = BSIK-WRBTR * -1.
        WQSSHB = BSIK-QSSHB * -1.
        WQBSHB = BSIK-QBSHB * -1.
        WQSFBT = WDMBTR - WQSSHB.
        NETTO  = WDMBTR - WQBSHB.
      ENDIF.

      P_PROCESSING_FLAG = 'X'.

ENDFORM.                    " PREP_DATA_EXTR_OLD_WT_CTRGR_3

