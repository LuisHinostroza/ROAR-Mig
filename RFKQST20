*&---------------------------------------------------------------------*
*&      Form  GET_REPYEAR
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->P_H_REPYEAR  text
*----------------------------------------------------------------------*
FORM GET_REPYEAR TABLES I_REPYEAR LIKE T_REPYEAR[].

DATA: CURRENT_INDEX TYPE I,
      LOWER_BUDAT LIKE BSIK-BUDAT.

  CLEAR   I_REPYEAR.
  REFRESH I_REPYEAR.

  LOOP.

    AT NEW BSIK-BUKRS.
      I_REPYEAR-BUKRS   = BSIK-BUKRS.
      I_REPYEAR-REPYEAR = BSIK-GJAHR.
      APPEND I_REPYEAR.
      CURRENT_INDEX = SY-TABIX.
      LOWER_BUDAT = BSIK-BUDAT.
    ENDAT.

    IF BSIK-BUDAT <  LOWER_BUDAT AND
       BSIK-GJAHR <> I_REPYEAR-REPYEAR.
      I_REPYEAR-REPYEAR = BSIK-GJAHR.
      MODIFY I_REPYEAR INDEX CURRENT_INDEX.
    ENDIF.

  ENDLOOP.

ENDFORM.                    " GET_REPYEAR

*&---------------------------------------------------------------------*
*&      Form  GET_TAX_AMOUNT
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->P_WDMBTR  text
*      -->P_VDMBTR  text
*----------------------------------------------------------------------*
FORM GET_TAX_AMOUNT TABLES P_X_WT_AT_INVOICE LIKE X_WT_AT_INVOICE[]
                     USING VALUE(P_EXT_WT)
                           VALUE(P_BSIK)  LIKE BSIK
                                 P_VDMBTR LIKE BSET-HWSTE.

DATA: I_BSEG LIKE BSEG OCCURS 10 WITH HEADER LINE.
DATA: I_BSET LIKE BSET OCCURS 10 WITH HEADER LINE.
DATA: SUM_DMBTR LIKE BSIK-DMBTR,
      H_DMBTR   LIKE BSIK-DMBTR,
      SUM_HWSTE LIKE BSET-HWSTE,
      P_RATE TYPE F.

  CLEAR P_VDMBTR.

* Get complete document
  SELECT * FROM BSEG INTO TABLE I_BSEG WHERE BUKRS = P_BSIK-BUKRS
                                         AND BELNR = P_BSIK-BELNR
                                         AND GJAHR = P_BSIK-GJAHR.

* Add WT at invoice amounts
  IF P_EXT_WT = 'X'.
    LOOP AT I_BSEG WHERE KOART = 'K'.
*     Read total WT at invoice
      READ TABLE P_X_WT_AT_INVOICE WITH KEY BUKRS = I_BSEG-BUKRS
                                            BELNR = I_BSEG-BELNR
                                            GJAHR = I_BSEG-GJAHR
                                            BUZEI = I_BSEG-BUZEI.
      IF P_X_WT_AT_INVOICE-WT_QBSHH < 0.
        P_X_WT_AT_INVOICE-WT_QBSHH = P_X_WT_AT_INVOICE-WT_QBSHH * -1.
      ENDIF.
      I_BSEG-DMBTR = I_BSEG-DMBTR + P_X_WT_AT_INVOICE-WT_QBSHH.
      MODIFY I_BSEG.
    ENDLOOP.
  ENDIF.

* Get tax information
  SELECT * FROM BSET INTO TABLE I_BSET WHERE BUKRS = P_BSIK-BUKRS
                                         AND BELNR = P_BSIK-BELNR
                                         AND GJAHR = P_BSIK-GJAHR.

* Determine relative contribution of current vendor line
  CLEAR SUM_DMBTR.
  LOOP AT I_BSEG WHERE KOART = 'K'.

    IF I_BSEG-SHKZG = 'H'.
      I_BSEG-DMBTR = I_BSEG-DMBTR * -1.
    ENDIF.

    SUM_DMBTR = SUM_DMBTR + I_BSEG-DMBTR.
    IF I_BSEG-BUZEI = P_BSIK-BUZEI.
      H_DMBTR = I_BSEG-DMBTR.
    ENDIF.

  ENDLOOP.

  IF SUM_DMBTR <> 0.
    P_RATE = H_DMBTR / SUM_DMBTR.
  ELSE.
    P_RATE = 0.
  ENDIF.

* Determine tax amount
  CLEAR SUM_HWSTE.
  LOOP AT I_BSET.
    IF I_BSET-SHKZG = 'H'.
      I_BSET-HWSTE = I_BSET-HWSTE * -1.
    ENDIF.
    SUM_HWSTE = SUM_HWSTE + I_BSET-HWSTE.
  ENDLOOP.

  P_VDMBTR = P_RATE * SUM_HWSTE.

ENDFORM.                    " GET_TAX_AMOUNT

*&---------------------------------------------------------------------*
*&      Form  GET_TOTAL_WT_AT_INVOICE
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->P_X_WITH_ITEM  text
*      -->P_X_T059P  text
*      -->P_X_WT_AT_INVOICE  text
*----------------------------------------------------------------------*
FORM GET_TOTAL_WT_AT_INVOICE
                  TABLES P_X_WITH_ITEM STRUCTURE WITH_ITEM
                         P_X_T059P STRUCTURE T059P
                         P_X_WT_AT_INVOICE LIKE X_WT_AT_INVOICE[]
                   USING VALUE(P_LAND1) LIKE T001-LAND1.

    CLEAR   P_X_WT_AT_INVOICE.        " Set accumulation values to zero
    REFRESH P_X_WT_AT_INVOICE.

    LOOP AT P_X_WITH_ITEM.                         " Loop over WT types

*     WT type with posting at invoice or at payment?
      PERFORM READ_T059P TABLES P_X_T059P
                          USING P_LAND1
                                P_X_WITH_ITEM-WITHT.

*     If Withholding tax at invoice, accumulate the WT amounts.
      IF P_X_T059P-WT_POSTM = '1'.
        P_X_WT_AT_INVOICE-BUKRS    = P_X_WITH_ITEM-BUKRS.
        P_X_WT_AT_INVOICE-BELNR    = P_X_WITH_ITEM-BELNR.
        P_X_WT_AT_INVOICE-GJAHR    = P_X_WITH_ITEM-GJAHR.
        P_X_WT_AT_INVOICE-BUZEI    = P_X_WITH_ITEM-BUZEI.
        P_X_WT_AT_INVOICE-WT_QBSHH = P_X_WITH_ITEM-WT_QBSHH.
        P_X_WT_AT_INVOICE-WT_QBSHB = P_X_WITH_ITEM-WT_QBSHB.
        COLLECT P_X_WT_AT_INVOICE.
      ENDIF.

    ENDLOOP.                                         " at p_x_with_item

ENDFORM.                    " GET_TOTAL_WT_AT_INVOICE
