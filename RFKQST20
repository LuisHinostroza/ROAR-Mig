*----------------------------------------------------------------------*
*                   Form 'prep_data_extract_ext_wt_ctrgr_1'            *
*                   Performs several selection checks and fills        *
*                   the fields of the data extract.                    *
*                   The selection checks are specific for the          *
*                   country group (ctrgr).                             *
*                   Country group 1 is currently used for:             *
*                   IT, ES, CZ                                         *
*----------------------------------------------------------------------*
FORM PREP_DATA_EXTR_EXT_WT_CTRGR_1 CHANGING P_PROCESSING_FLAG.

      CLEAR P_PROCESSING_FLAG.

      CHECK BELNUM.
      CASE BSIK-UMSKS.
        WHEN ' '.
          CHECK BSIK-AUGBL NE SPACE.
          CHECK AUGDAT.
          CHECK BSIK-BSCHL IN BUSCHL.
        WHEN 'A'.
          CHECK BUCHDT.
          IF BSIK-SHKZG EQ 'S'.
            MOVE  'H' TO BSIK-SHKZG.
          ELSE.
            MOVE  'S' TO BSIK-SHKZG.
          ENDIF.
*         ------------------- Switch sign of WT in case of down payment
          X_WITH_ITEM-WT_QSSHH = X_WITH_ITEM-WT_QSSHH * -1.
          X_WITH_ITEM-WT_QBSHH = X_WITH_ITEM-WT_QBSHH * -1.
        WHEN OTHERS.
          REJECT.
      ENDCASE.

      IF BSIK-SHKZG EQ 'H'.
        WDMBTR = H_DMBTR.
        WWRBTR = BSIK-WRBTR.
        WQSSHB = X_WITH_ITEM-WT_QSSHH * -1.
        WQBSHB = X_WITH_ITEM-WT_QBSHH * -1.
      ELSE.
        WDMBTR = H_DMBTR * -1.
        WWRBTR = BSIK-WRBTR * -1.
        WQSSHB = X_WITH_ITEM-WT_QSSHH * -1.
        WQBSHB = X_WITH_ITEM-WT_QBSHH * -1.
      ENDIF.

      WQSFBT = WDMBTR - WQSSHB.
      NETTO  = WDMBTR - WQBSHB.

      P_PROCESSING_FLAG = 'X'.

ENDFORM.                        " Of 'prep_data_extract_ext_wt_ctrgr_1'

