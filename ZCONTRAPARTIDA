form %t01out using sflag vlevel.

data: eflag(1),
      lline like %line,
      curr  like %curr.

  if %vlevel > vlevel.
    exit.
  endif.
  clear t01err.
  if %convflag <> space.
    move-corresponding t01 to t01err.
    read table t01err.
  endif.
  new-line.
  if sflag = 'X'.
    format intensified on color 3.
    %fint = 'N'. %fcol = '3'.
  elseif sflag = 'Z'.
    format intensified off color 3.
    %fint = 'F'. %fcol = '3'.
  else.
    format intensified off color 2.
    %fint = 'F'. %fcol = '2'.
  endif.
  write sy-vline no-gap.
  if sflag = space.
    write (010) t01-BSEG-HKONT no-gap intensified on color 4 .
  else.
    perform empty_field(rsaqexce) using
            t01-BSEG-HKONT 010 eflag.
    if eflag = space.
    write (010) t01-BSEG-HKONT no-gap .
    endif.
  endif.
  write sy-vline no-gap.
  set left scroll-boundary.
  perform set_scroll_boundary(rsaqexce) using sy-colno.
  if sflag = space.
    write (002) t01-BSEG-BSCHL no-gap intensified on color 4 .
  else.
    perform empty_field(rsaqexce) using
            t01-BSEG-BSCHL 002 eflag.
    if eflag = space.
    write (002) t01-BSEG-BSCHL no-gap .
    endif.
  endif.
  write sy-vline no-gap.
  set left scroll-boundary.
  perform set_scroll_boundary(rsaqexce) using sy-colno.
  if %curr = space.
    curr = 'USD'.
  else.
    curr = %curr.
  endif.
  if sflag = space.
    if t01err-IMPORTE-%c <> 0.
      write (016) t01-IMPORTE no-gap color 6 inverse currency curr .
    else.
    write (016) t01-IMPORTE no-gap currency curr .
    endif.
  else.
    write (016) t01-IMPORTE no-gap currency curr .
  endif.
  write sy-vline no-gap.
  if sflag = space.
    write (016) t01-IMPORTE_MD no-gap .
  else.
    write (016) t01-IMPORTE_MD no-gap .
  endif.
  write sy-vline no-gap.
  if sflag = space.
    write (005) t01-BKPF-WAERS no-gap intensified on color 4 .
  else.
    perform empty_field(rsaqexce) using
            t01-BKPF-WAERS 005 eflag.
    if eflag = space.
    write (005) t01-BKPF-WAERS no-gap .
    endif.
  endif.
  write sy-vline no-gap.
  set left scroll-boundary.
  perform set_scroll_boundary(rsaqexce) using sy-colno.
  if sflag = space.
    %line = %line + 1.
    lline = %line.
  else.
    lline = %line.
    %line = 0.
  endif.
  perform %hide.
  perform %hide_color.
  %line = lline.
  clear %ustflag.

endform.


