Buscó chats anteriores
Te paso las tres vistas que cambian, completas, partiendo de la última versión que armamos (la de ZC_Contrapartida como root). Si después de eso les hiciste más ajustes, compáralas antes de pegarlas.

Al revisarlas encontré algo: AccountingDocumentType ya venía en ZI_Contrapartida y en ZC_Contrapartida, pero nunca se proyectó en ZCP_Contrapartida. Por eso no aparece en la app. Además, como la basic filtra FinancialAccountType = 'S', el centro de coste se toma directamente de esa misma línea de mayor, que es la correcta.

1. ZI_Contrapartida (basic)
abap
@AccessControl.authorizationCheck: #NOT_REQUIRED
@VDM.viewType: #BASIC
@EndUserText.label: 'Contrapartida - Base'
define view entity ZI_Contrapartida
  as select from I_OperationalAcctgDocItem as Item

  association [0..1] to I_GLAccountInCompanyCode as _GLAcctCoCode
    on  _GLAcctCoCode.CompanyCode = Item.CompanyCode
    and _GLAcctCoCode.GLAccount   = Item.GLAccount

{
  key Item.CompanyCode,
  key Item.FiscalYear,
  key Item.AccountingDocument,
  key Item.AccountingDocumentItem,
      Item.GLAccount,
      Item.PostingKey,
      Item.AbsoluteAmountInCoCodeCrcy      as Amount,
      Item.CompanyCodeCurrency,
      Item.DocumentItemText,
      Item.PostingDate,
      Item.AccountingDocumentType,
      Item.TreasuryContractType,
      Item.AssetContract,
      Item.TaxAbsltBaseAmountInCoCodeCrcy  as TaxBaseAmount,
      Item.CostCenter,                                        // KOSTL
      _GLAcctCoCode.AlternativeGLAccount   as AlternativeGLAccount  // SKB1-ALTKT -- confirmar nombre con F2
}
where Item.FinancialAccountType = 'S'
2. ZC_Contrapartida (composite, root)
abap
@AccessControl.authorizationCheck: #NOT_REQUIRED
@VDM.viewType: #COMPOSITE
@EndUserText.label: 'Contrapartida - Composite'
define root view entity ZC_Contrapartida
  as select from ZI_Contrapartida as Item

  association [0..1] to ZI_CtrapProveedor as _Proveedor
    on  _Proveedor.CompanyCode        = Item.CompanyCode
    and _Proveedor.FiscalYear         = Item.FiscalYear
    and _Proveedor.AccountingDocument = Item.AccountingDocument

  association [0..1] to ZI_CtrapDeudor as _Deudor
    on  _Deudor.CompanyCode        = Item.CompanyCode
    and _Deudor.FiscalYear         = Item.FiscalYear
    and _Deudor.AccountingDocument = Item.AccountingDocument

  association [0..1] to I_AccountingDocumentTypeText as _DocTypeText
    on  _DocTypeText.AccountingDocumentType = Item.AccountingDocumentType
    and _DocTypeText.Language               = $session.system_language

{
  key Item.CompanyCode,
  key Item.FiscalYear,
  key Item.AccountingDocument,
  key Item.AccountingDocumentItem,
      Item.GLAccount,
      Item.PostingKey,
      Item.Amount,
      Item.CompanyCodeCurrency,
      Item.DocumentItemText,
      Item.PostingDate,
      Item.AccountingDocumentType,
      _DocTypeText.AccountingDocumentTypeName as AccountingDocumentTypeName,
      Item.TreasuryContractType,
      Item.AssetContract,
      Item.TaxBaseAmount,
      Item.CostCenter,
      Item.AlternativeGLAccount,
      _Proveedor.Supplier      as Proveedor,
      _Proveedor.SupplierName  as NombreProveedor,
      _Proveedor.TaxNumber1    as NifProveedor,
      _Deudor.Customer         as Deudor,
      _Deudor.TaxNumber1       as NifCliente
}
