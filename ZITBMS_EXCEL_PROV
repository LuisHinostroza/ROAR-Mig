4. ZI_ItbmsSupplier (proveedores R1/A1 y clasificación)
abap
@AccessControl.authorizationCheck: #NOT_REQUIRED
@EndUserText.label: 'ITBMS Prov - Proveedores R1/A1'
define view entity ZI_ItbmsSupplier
  as select from lfbw
    inner join   lfa1 on lfa1.lifnr = lfbw.lifnr
{
  key lfbw.bukrs as CompanyCode,
  key lfbw.lifnr as Supplier,

      cast( lfa1.stcd1 as abap.char( 20 ) )            as Ruc,
      cast( left( lfa1.stcd2, 2 ) as abap.char( 2 ) )  as Dv,

      cast( concat_with_space(
              concat_with_space( lfa1.name1, lfa1.name2, 1 ),
              lfa1.name3, 1 ) as abap.char( 100 ) )    as Nombre,

      cast( case
              when lfa1.land1 <> 'PA'                       then 'P'
              when instr( upper( lfa1.stcd1 ), 'NT' ) > 0   then 'P'
              when lfa1.stkzn = 'X'                         then 'N'
              else                                               'J'
            end as abap.char( 1 ) )                    as TipoPersona
}
where lfbw.witht     = 'R1'
  and lfbw.wt_withcd = 'A1'
5. ZC_ItbmsProveedor (composite)
abap
@AccessControl.authorizationCheck: #NOT_REQUIRED
@EndUserText.label: 'ITBMS Prov - Composite'
define view entity ZC_ItbmsProveedor
  as select from bkpf                     as h
    inner join   ZI_ItbmsDocAmount        as a on  a.CompanyCode        = h.bukrs
                                               and a.AccountingDocument = h.belnr
                                               and a.FiscalYear         = h.gjahr
    inner join   ZI_ItbmsDocFirstSuppItem as f on  f.CompanyCode        = h.bukrs
                                               and f.AccountingDocument = h.belnr
                                               and f.FiscalYear         = h.gjahr
    inner join   bseg                     as v on  v.bukrs = f.CompanyCode
                                               and v.belnr = f.AccountingDocument
                                               and v.gjahr = f.FiscalYear
                                               and v.buzei = f.FirstSupplierItem
    inner join   ZI_ItbmsSupplier         as s on  s.CompanyCode = v.bukrs
                                               and s.Supplier    = v.lifnr
{
  key h.bukrs                                    as CompanyCode,
  key h.belnr                                    as AccountingDocument,
  key h.gjahr                                    as FiscalYear,
      h.blart                                    as AccountingDocumentType,
      h.monat                                    as FiscalPeriod,
      h.waers                                    as TransactionCurrency,
      v.lifnr                                    as Supplier,

      s.TipoPersona,
      s.Ruc,
      s.Dv,
      s.Nombre,
      cast( h.xblnr as abap.char( 22 ) )         as Documento,

      @Semantics.amount.currencyCode: 'TransactionCurrency'
      cast( a.MontoGravado * -1 as abap.curr( 23, 2 ) )  as MontoGravado,

      @Semantics.amount.currencyCode: 'TransactionCurrency'
      cast( a.ItbmsCausado * -1 as abap.curr( 23, 2 ) )  as ItbmsCausado,

      cast( '4' as abap.char( 1 ) )              as ObjRetencion,

      @Semantics.amount.currencyCode: 'TransactionCurrency'
      cast( a.ItbmsRetenido as abap.curr( 23, 2 ) )      as ItbmsRetenido
}
where h.stblg            = ''
  and a.HasOpenRetention = 'X'
