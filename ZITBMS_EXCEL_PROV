1. ZI_ItbmsDocItem (líneas de las cuentas ITBMS con signo)
abap
@AccessControl.authorizationCheck: #NOT_REQUIRED
@EndUserText.label: 'ITBMS Prov - Posiciones cuentas ITBMS'
define view entity ZI_ItbmsDocItem
  as select from bseg
{
  key bukrs as CompanyCode,
  key belnr as AccountingDocument,
  key gjahr as FiscalYear,
  key buzei as AccountingDocumentItem,
      hkont as GLAccount,
      buzid as LineItemId,
      augbl as ClearingDocument,
      shkzg as DebitCreditCode,

      case shkzg
        when 'S' then cast( wrbtr as abap.dec( 23, 2 ) ) * -1
        else          cast( wrbtr as abap.dec( 23, 2 ) )
      end as AmountSigned,

      case shkzg
        when 'S' then cast( fwbas as abap.dec( 23, 2 ) ) * -1
        else          cast( fwbas as abap.dec( 23, 2 ) )
      end as TaxBaseSigned
}
where hkont = '0000204000'
   or hkont = '0000204001'
2. ZI_ItbmsDocAmount (importes por documento)
abap
@AccessControl.authorizationCheck: #NOT_REQUIRED
@EndUserText.label: 'ITBMS Prov - Importes por documento'
define view entity ZI_ItbmsDocAmount
  as select from ZI_ItbmsDocItem
{
  key CompanyCode,
  key AccountingDocument,
  key FiscalYear,

      sum( case when GLAccount = '0000204001'
                then AmountSigned
                else cast( 0 as abap.dec( 23, 2 ) ) end )  as ItbmsRetenido,

      sum( case when GLAccount = '0000204000' and LineItemId = 'T'
                then TaxBaseSigned
                else cast( 0 as abap.dec( 23, 2 ) ) end )  as MontoGravado,

      sum( case when GLAccount = '0000204000'
                then AmountSigned
                else cast( 0 as abap.dec( 23, 2 ) ) end )  as ItbmsCausado,

      max( case when GLAccount = '0000204001' and ClearingDocument = ''
                then 'X' else '' end )                      as HasOpenRetention
}
group by CompanyCode,
         AccountingDocument,
         FiscalYear
