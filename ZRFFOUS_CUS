  up_objcont-line            = text-912.       APPEND up_objcont.
  up_objcont-line            = text-913.       APPEND up_objcont.
  up_objcont-line            = space.          APPEND up_objcont.
  up_objcont-line            = text-914.
  GET PARAMETER ID 'BUK' FIELD reguh-zbukr.
