            documentclass            = ld_documentclass  " 1683912
          EXCEPTIONS
          error_archiv             = 1
          error_communicationtable = 2
          error_connectiontable    = 3
          error_kernel             = 4
          error_parameter          = 5
          OTHERS                   = 6.
*        Fehlermeldung
        IF sy-subrc <> 0.
