  IF NOT hlp_pdfformular IS INITIAL.
    gs_fpayhx-pdfaf = hlp_pdfformular.
    IF finaa-nacha NE '1'.
*--- get PDF for fax or e-mail
      l_xgetpdf = 'X'.
    ENDIF.
*--- PDF Formular erzeugen
    data l_xstring_pdf type xstring.
    CALL FUNCTION 'FI_PDF_ADVICE_OUTPUT'
      EXPORTING
        is_fpayh          = gs_fpayh
        is_fpayhx         = gs_fpayhx
        is_fpparams       = gs_fpparams
