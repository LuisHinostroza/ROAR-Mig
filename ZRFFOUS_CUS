        err_element-fenst = 'CARRYFWD'.
        err_element-elemt = '635'.
        err_element-text  = text_635.
        COLLECT err_element.
      ENDIF.

*   Hauptfenster, Element Anschreiben-x (nur auf der ersten Seite)
      CALL FUNCTION 'WRITE_FORM'
        EXPORTING
          element = hlp_element
        EXCEPTIONS
          window  = 1
          element = 2.
      IF sy-subrc EQ 2.
        CALL FUNCTION 'WRITE_FORM'
          EXPORTING
            element = '610'
          EXCEPTIONS
            window  = 1
            element = 2.
