    par_sofa = 'X'.
    par_sofb = 'X'.
  ENDIF.

* Vorbelegen von Feldern -----------------------------------------------
* fields with fix values -----------------------------------------------
  hlp_maxbetrag = 10000000000000.
  hlp_zeilen    = 0.

  CLEAR txt_uline1 WITH '_'.
  CLEAR txt_uline2 WITH '='.

  CALL FUNCTION 'FI_DME_CHARACTERS'
