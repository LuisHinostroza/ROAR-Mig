      IMPORTING
        outtext = textfeld
      EXCEPTIONS
        OTHERS  = 01.
  ENDIF.
  TRANSLATE textfeld TO UPPER CASE.

ENDFORM.                               "DTA_TEXT_AUFBEREITEN


