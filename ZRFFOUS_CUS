      CALL FUNCTION 'REUSE_ALV_VARIANT_EXISTENCE'
           EXPORTING
                i_save     = 'A'
           CHANGING
                cs_variant = gs_variant.
    ENDIF.
    HLP_LAYB = PAR_LAYB.

  AT SELECTION-SCREEN ON par_alvb.
    HLP_ALVB = PAR_ALVB.

  AT SELECTION-SCREEN ON par_disb.
    HLP_DISB = PAR_DISB.

