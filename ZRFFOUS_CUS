          EXPORTING
            element  = '629'
            function = 'APPEND'
          EXCEPTIONS
            window   = 1
            element  = 2.
      ENDAT.
    ENDLOOP.

    PERFORM ziffern_in_worten.

* Summenfelder hochzählen und aufbereiten
    CASE finaa-nacha.
      WHEN '1'.
        ADD 1           TO cnt_avise.
        ADD reguh-rbetr TO sum_abschluss.
      WHEN '2'.
        ADD 1           TO cnt_avfax.
        ADD reguh-rbetr TO sum_abschl_fax.
