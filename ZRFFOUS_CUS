      regud-avise  USING ' *',
      regud-avedi  USING ' *',
      regud-avfax  USING ' *',
      regud-avmail USING ' *',
      regud-summe  USING ' *',
      regud-suedi  USING ' *',
      regud-sufax  USING ' *',
