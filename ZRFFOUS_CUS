    IF sy-batch EQ space.
      MESSAGE ID lt_fimsg-msgid TYPE lt_fimsg-msgty
                                NUMBER lt_fimsg-msgno
                                WITH lt_fimsg-msgv1 lt_fimsg-msgv2
                                     lt_fimsg-msgv3 lt_fimsg-msgv4.
