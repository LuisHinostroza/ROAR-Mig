*&---------------------------------------------------------------------*
*&      Form  FILENAME_SERVER
*&---------------------------------------------------------------------*
*    Lee de un directorio del servidor todos los ficheros que contiene
*  si pchar es "A" la lectura de los ficheros del directorio  se  hará
*  por orden de creación
*----------------------------------------------------------------------*
*  -->P_TABLA  Lista de ficheros en el directorio
*  -->P_PATH   Directorio que leemos (P_PATH LIKE ibipparms-path)
* longitud de la tabla:
*
* Para el comando "ls":
*  70 -> Nombre del fichero
*
* Para el comando "ll": En la 1 linea de la tabla = el nº tot. bytes
*  10 -> caracteristicas del fichero
*   5 ->
*  11 ->
*   6 -> Propietario
*  12 -> Nº bytes
*   4 -> Mes
*   3 -> Dia
*   7 -> Hora































































































































































































































































*  70 -> Fichero
*----------------------------------------------------------------------*
FORM filename_server TABLES   p_tabla
                     USING    p_path
                              p_char.

  DATA: unix_loc(200).

  IF NOT ( p_path CA '|;,<>' ).  "don't allow the user to do dirty things
    CASE p_char.
      WHEN 'A'.
        unix_loc = 'ls -tr '.
        MOVE p_path TO unix_loc+7.
      WHEN 'B'.
        unix_loc = 'ls -t '.
        MOVE p_path TO unix_loc+6.
      WHEN 'C'.
        unix_loc = 'll -tr '.
        MOVE p_path TO unix_loc+7.
      WHEN 'D'.
        unix_loc = 'll -t '.
        MOVE p_path TO unix_loc+6.
      WHEN OTHERS.
        unix_loc = 'ls '.
        MOVE p_path TO unix_loc+3.
    ENDCASE.
  ELSE.
    CASE p_char.
      WHEN 'A'.
        unix_loc = 'ls -tr *.*'.
        MOVE p_path TO unix_loc+10.
      WHEN 'B'.
        unix_loc = 'ls -t *.*'.
        MOVE p_path TO unix_loc+9.
      WHEN 'C'.
        unix_loc = 'll -tr *.*'.
        MOVE p_path TO unix_loc+10.
      WHEN 'D'.
        unix_loc = 'll -t *.*'.
        MOVE p_path TO unix_loc+6.
      WHEN OTHERS.
        unix_loc = 'ls *.*'.
    ENDCASE.
  ENDIF.
  REFRESH p_tabla.
  CALL 'SYSTEM' ID 'COMMAND' FIELD unix_loc
                ID 'TAB'     FIELD p_tabla-*sys*.

ENDFORM.                               " FILENAME_SERVER


