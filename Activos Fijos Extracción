    CALL FUNCTION 'BDC_OPEN_GROUP'
      EXPORTING
        client              = sy-mandt
        group               = group
        user                = sy-uname
        keep                = 'X'
      EXCEPTIONS
        client_invalid      = 1
        destination_invalid = 2
        group_invalid       = 3
        holddate_invalid    = 4
        internal_error      = 5
        queue_error         = 6
        running             = 7
        user_invalid        = 8.
    IF sy-subrc = 0.
*Si se ha podido abrir, OFFLINE; si no, ONLINE
      online = falso.
    ENDIF.
  ENDIF.
ENDFORM.                                                    " BDC_OPEN

