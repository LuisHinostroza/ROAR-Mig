FORM buscar_spool USING orden_num
                        fichero.
  CLEAR orden_num.
  IF sy-batch = 'X'.
    "buscamos la spool de una forma, por job.
    PERFORM get_job_details.
    PERFORM obtain_spool_id.
  ELSE.
    "buscamos la spool en la TSP01.
    "En título de la orden metimos en fichero con el path del APV
    REFRESH t_tsp01.
    SELECT  * FROM tsp01 INTO TABLE t_tsp01 WHERE rqtitle = fichero.
* ordenamos por Hora de creación y por numero de una orden SPOOL
    SORT t_tsp01 BY rqcretime DESCENDING rqident DESCENDING.
    "la de número más algo queda arriba
    LOOP AT t_tsp01.
      EXIT. "nos salimos en la primera.
    ENDLOOP.
    orden_num = t_tsp01-rqident.
  ENDIF.
