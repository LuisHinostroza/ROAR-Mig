FORM procesa_bi USING value(bi_name).

*--  De la funcion BDC_CLOSE_GROUP se debe obtener la variable bqid
*-- pueden existir dos juegos de datos con el mismo nombre
  TABLES: apqi.
  DATA: jobcount LIKE tbtcjob-jobcount,
        jobname  LIKE tbtcjob-jobname.

  jobname = bi_name.
  SELECT * FROM apqi WHERE destsys = '        '
                       AND destapp = '        '
                       AND datatyp = 'BDC'
                       AND mandant = sy-mandt
                       AND groupid = bi_name
                       AND progid  = '        '
                       AND qattrib = ' '
                       AND qstate  = ' '.
    EXIT.
  ENDSELECT.

  IF sy-subrc = 0.
    CALL FUNCTION 'JOB_OPEN'
      EXPORTING
        jobgroup = 'BATCH-INPUT'
        jobname  = jobname
      IMPORTING
        jobcount = jobcount.

    SUBMIT rsbdcbtc USER sy-uname
          VIA JOB jobname NUMBER jobcount
          WITH queue-id EQ apqi-qid
          WITH mappe    EQ apqi-groupid
          WITH modus    EQ 'N'
          AND RETURN.

    CALL FUNCTION 'JOB_CLOSE'
      EXPORTING
        jobcount  = jobcount
        jobname   = jobname
        strtimmed = 'X'.

  ENDIF.

ENDFORM.                               " PROCESA_BI
