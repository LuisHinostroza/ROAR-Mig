*----------------------------------------------------------------------*
FORM z_exec_jd USING destsys destapp datatyp
                     groupid progid  formid
                     qattrib qid     qstate.

*--  De la funcion BDC_CLOSE_GROUP se debe obtener la variable bqid
*-- pueden existir dos juegos de datos con el mismo nombre
  DATA: jobcount LIKE tbtcjob-jobcount,
        jobname  LIKE tbtcjob-jobname.

  SELECT SINGLE * FROM apqi WHERE
         destsys = destsys  AND
         destapp = destapp  AND
         datatyp = datatyp  AND
         mandant = sy-mandt AND
         groupid = groupid  AND
         progid  = progid   AND
         formid  = formid   AND
         qattrib = qattrib  AND
         qid     = qid.
*{   DELETE         TSTK900297                                        1
*\  if sy-subrc ne 0.
*}   DELETE
  IF sy-subrc NE 0.

  ELSE.
*   Nombre del Job
    jobname = groupid.
    CALL FUNCTION 'JOB_OPEN'
      EXPORTING
        jobgroup = 'BATCH-INPUT'
        jobname  = jobname
      IMPORTING
        jobcount = jobcount.
*
*{   REPLACE        TSTK900297                                        2
*\    submit rsbdcbtc user sy-uname
*\       via job jobname number jobcount
*\          with queue-id eq apqi-qid
*\          with mappe    eq apqi-groupid
*\          with modus    eq 'N'
* \          and return.
*-- han cambiado la variable queue-id por queue_id
    SUBMIT rsbdcbtc USER sy-uname
       VIA JOB jobname NUMBER jobcount
          WITH queue_id EQ apqi-qid
          WITH mappe    EQ apqi-groupid
          WITH modus    EQ 'N'
          AND RETURN.
*}   REPLACE
*
    CALL FUNCTION 'JOB_CLOSE'
      EXPORTING
        jobcount  = jobcount
        jobname   = jobname
        strtimmed = 'X'.

  ENDIF.


ENDFORM.                    " Z_EXEC_JD

