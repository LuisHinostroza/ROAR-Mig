*&---------------------------------------------------------------------*
*&      Form  FILE_DIRECTORY_COPY
*&---------------------------------------------------------------------*
*   Mueve de un directorio origen a otro destino un fichero
* Server<->Clinet No esta implementada
*----------------------------------------------------------------------*
*      -->P_PATH_ORIGEN   Ruta origen
*      -->P_PATH_DESTINO  Ruta destino
*      -->P_FICHERO       Nombre del fichero que queremos mover
*      -->P_L_RETORNO     Código de retorno
*----------------------------------------------------------------------*
FORM file_directory_copy USING    p_path_origen
                                  p_path_destino
                                  p_fichero
                                  p_retorno.
*-- Constantes
  CONSTANTS:
*                                       Origen -> Destino
       c_1(27) TYPE c VALUE 'ARCHIVFILE_SERVER_TO_SERVER',
       c_2(27) TYPE c VALUE 'ARCHIVFILE_SERVER_TO_CLIENT',
       c_3(27) TYPE c VALUE 'ARCHIVFILE_CLIENT_TO_CLIENT',
       c_4(27) TYPE c VALUE 'ARCHIVFILE_CLIENT_TO_SERVER'.
  DATA:
       l_0(27) TYPE c,
       l_path_d LIKE sapb-sappfad,
       l_path_o LIKE sapb-sappfad.

  IF p_path_origen NE p_path_destino.
    CONCATENATE p_path_destino p_fichero INTO l_path_d.
    CONCATENATE p_path_origen  p_fichero INTO l_path_o.

    IF l_path_o CS '/'.
*   SERVER -> ¿...?
      IF l_path_d CS '/'.
*     SERVER -> SERVER
        l_0 = c_1.
      ELSE.
*     SERVER -> CLIENT
        l_0 = c_2.
      ENDIF.
    ELSE.
*   CLIENT -> ¿...?
      IF l_path_d CS '/'.
*     CLIENT -> SERVER
        l_0 = c_4.
      ELSE.
*     CLIENT -> CLIENT
        l_0 = c_3.
      ENDIF.
    ENDIF.
* Inicio Modificación UNICODE - 04/02/09 - EVERIS
*    CALL FUNCTION l_0
*         EXPORTING
*              sourcepath = l_path_o
*              targetpath = l_path_d
**    IMPORTING
**         LENGTH     =
*        EXCEPTIONS
*             error_file = 1
*             OTHERS     = 2.
    IF l_0 = c_1.
      CALL FUNCTION l_0
        EXPORTING
          sourcepath = l_path_o
          targetpath = l_path_d
        EXCEPTIONS
          error_file = 1
          OTHERS     = 2.

    ELSE.
      CALL FUNCTION l_0
        EXPORTING
          path       = l_path_o
          targetpath = l_path_d
        EXCEPTIONS
          error_file = 1
          OTHERS     = 2.
    ENDIF.
* Fin Modificación UNICODE - 04/02/09 - EVERIS

    CASE sy-subrc.
      WHEN 0.
*     Borramos el fichero origen
        PERFORM delete_file USING l_path_o.
        IF sy-subrc NE 0.
*--     No pudo ser borrado
          p_retorno = 1.
        ENDIF.
      WHEN OTHERS.
*--   El fichero no pudo copiarse
        p_retorno = 2.
    ENDCASE.
  ENDIF.
ENDFORM.                               " FILE_DIRECTORY_COPY

