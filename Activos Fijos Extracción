*                      pdf_xstring.

  DATA: p_destinatarios TYPE somlreci1,
  mailto  TYPE ad_smtpadr.

  REFRESH it_mess_bod.

* Default subject matter
  CONCATENATE 'Proceso del fichero' sy-sysid p_fentra INTO gd_subject
              SEPARATED BY space.
  IF p_iden = 'PCE_'. "PROCESO CONT. ESPECIAL.
    REPLACE 'Proceso del fichero'
            WITH
            'Contabilización Especial: - '
            INTO gd_subject.
* para planes de facturacion y pedidos
  ELSEIF p_iden = 'CPA_' OR p_iden = 'VEN_'.
    REPLACE 'Proceso del fichero'
            WITH
            'Planes/Pedidos Cargados: - '
            INTO gd_subject.
  ELSEIF p_iden = 'EPF_' OR p_iden = 'EVE_'.
    REPLACE 'Proceso del fichero'
            WITH
            'Planes/Pedidos Erroneos: - '
            INTO gd_subject.
  ELSEIF p_iden = 'RJD_'.
    REPLACE 'Proceso del fichero'
            WITH
            'Proceso: - '
            INTO gd_subject.
  ELSEIF p_iden = 'ARD_'.
    REPLACE 'Proceso del fichero'
            WITH
            'Carga automatica recibos: - '
            INTO gd_subject.
  ELSEIF p_iden = 'CKS_'. "ZCOSLB08 Creación de sets de CeCos automático
    REPLACE 'Proceso del fichero'
            WITH
            'Proceso: - '
            INTO gd_subject.
  ELSEIF p_iden = 'ZXN_'.
    REPLACE 'Proceso del fichero'
            WITH
            'Batch Input Log'
            INTO gd_subject.
  ELSEIF p_iden = 'TER_'. "Terceros
  ELSEIF p_iden = 'BCO_'. "Bancos Terceros
  ELSEIF p_iden = 'EMP_'. "Empleados
  ELSEIF p_iden = 'AGT_'. "Agentes
  ELSEIF p_iden = 'CAR_'. "cuadro amortizacion
  ELSEIF p_iden = 'AMA_'. "alta/mod. activos
  ELSEIF p_iden = 'BAF_'. "Baja activos
  ELSEIF p_iden = 'FCS_'. "Saldo Cuenta 440099
  ENDIF.

  CONCATENATE p_iden sy-datum INTO gd_attachment_desc.

*  CONCATENATE 'attach_name' ' ' INTO gd_attachment_name.
  CONCATENATE 'Resultado del Proceso del fichero' sy-sysid p_fentra
               INTO it_mess_bod SEPARATED BY space.

  IF p_iden = 'PCE_'. "PROCESO CONT. ESPECIAL.
    REPLACE 'Resultado del Proceso del fichero'
            WITH
            'Resultado Contabilización Especial: - '
            INTO it_mess_bod.
* para planes de facturacion y pedidos
  ELSEIF p_iden = 'CPA_' OR p_iden = 'VEN_'.
    REPLACE 'Resultado del Proceso del fichero'
            WITH
            'Planes/Pedidos Cargados: - '
            INTO it_mess_bod.
  ELSEIF p_iden = 'EPF_' OR p_iden ='EVE_'.
    REPLACE 'Resultado del Proceso del fichero'
            WITH
            'Planes/Pedidos Erroneos: - '
            INTO it_mess_bod.
  ELSEIF p_iden = 'RJD_'.
    REPLACE 'Resultado del Proceso del fichero'
            WITH
            'Resultado del proceso'
            INTO it_mess_bod.
  ELSEIF p_iden = 'CKS_'. "ZCOSLB08 Creación de sets de CeCos automático
    REPLACE 'Resultado del Proceso del fichero'
            WITH
            'Resultado del proceso'
            INTO it_mess_bod.
  ELSEIF p_iden = 'ARD_'.
    REPLACE 'Resultado del Proceso del fichero'
            WITH
            'Carga automatica recibos: - '
            INTO it_mess_bod.
  ELSEIF p_iden = 'TER_'. "Terceros
  ELSEIF p_iden = 'BCO_'. "Bancos Terceros
  ELSEIF p_iden = 'EMP_'. "Empleados
  ELSEIF p_iden = 'AGT_'. "Agentes
  ELSEIF p_iden = 'CAR_'. "cuadro amortizacion
  ELSEIF p_iden = 'AMA_'. "alta/mod. activos
  ELSEIF p_iden = 'BAF_'. "Baja activos
  ELSEIF p_iden = 'FCS_'. "Saldo Cuenta 440099

  ENDIF.

  TRY.

*     -------- create persistent send request ------------------------
      send_request = cl_bcs=>create_persistent( ).

*     -------- create and set document -------------------------------
      pdf_content = cl_document_bcs=>xstring_to_solix( pdf_xstring ).

      document = cl_document_bcs=>create_document(
            i_type    = 'PDF'
            i_hex     = pdf_content
            i_length  = pdf_size
            i_subject = gd_subject ).                       "#EC NOTEXT

*     add document object to send request
      send_request->set_document( document ).

*     --------- add recipient (e-mail address) -----------------------
*     create recipient object
      LOOP AT destinatarios INTO p_destinatarios.
        MOVE p_destinatarios-receiver TO mailto.
        recipient = cl_cam_address_bcs=>create_internet_address( mailto ).
*     add recipient object to send request
        send_request->add_recipient( i_recipient = recipient ).
      ENDLOOP.

*     ---------- send document ---------------------------------------
      sent_to_all = send_request->send( i_with_error_screen = 'X' ).
      COMMIT WORK.

      IF sent_to_all IS INITIAL.
        MESSAGE i500(sbcoms) WITH mailto.
      ELSE.
        MESSAGE s022(so).
      ENDIF.

*   ------------ exception handling ----------------------------------
*   replace this rudimentary exception handling with your own one !!!
    CATCH cx_bcs INTO bcs_exception.
      MESSAGE i865(so) WITH bcs_exception->error_type.
  ENDTRY.



*  APPEND it_mess_bod.
*
** If no sender specified - default blank
** IF p_sender EQ space.
*  gd_sender_type  = space.
** ELSE.
**   gd_sender_type  = 'INT'.
** ENDIF.
*
