*  <--  p2        text
*----------------------------------------------------------------------*
FORM f_show_log .
  TYPES: BEGIN OF ty_log_aux,
           line TYPE c LENGTH 150,
         END OF ty_log_aux.
  DATA: it_log_aux TYPE STANDARD TABLE OF ty_log_aux,
        wa_log_aux LIKE LINE OF it_log_aux.

  MOVE: text-003 TO wa_log_aux.
  APPEND wa_log_aux TO it_log_aux.
  CLEAR wa_log_aux.

  MOVE: p_ruta  TO wa_log_aux.
  APPEND wa_log_aux TO it_log_aux.
  CLEAR wa_log_aux.

  MOVE: space TO  wa_log_aux.
  APPEND wa_log_aux TO it_log_aux.
  CLEAR wa_log_aux.

  MOVE: text-004 TO wa_log-filename,
        text-006 TO wa_log-lin.
  INSERT wa_log INTO it_log INDEX 1.
  CLEAR wa_log.

  LOOP AT it_log INTO wa_log.
    WRITE wa_log TO wa_log_aux.
    APPEND wa_log_aux TO it_log_aux.
    CLEAR wa_log_aux.
  ENDLOOP.

  CALL FUNCTION 'C_POPUP_WITH_TABLE'
    EXPORTING
      endpos_col   = 80
      endpos_row   = 20
      startpos_col = 5
      startpos_row = 5
      titletext    = text-007
    TABLES
      valuetab     = it_log_aux
    EXCEPTIONS
      break_off    = 1
      OTHERS       = 2.
  IF sy-subrc EQ 0.
  ENDIF.
ENDFORM.                    " F_SHOW_LOG
