METHOD if_ex_me_process_po_cust~process_item.

    DATA: po_item     TYPE mepoitem,
          flog_active TYPE boolean.
    DATA(lo_validation) = cl_flog_ret_pcpr_validation=>create( ).

    TEST-SEAM check_feature.
      cl_flog_core_generic=>is_flog_businessfeature_active(
        IMPORTING
          ev_active = flog_active                 " Boolean Variable (X = True, - = False, Space = Unknown)
      ).
    END-TEST-SEAM.

    CHECK flog_active IS NOT INITIAL.               "#EC CHECK_POSITION

    DATA(lo_utility)  = cl_flog_ret_factory=>get_ret_utility( ).

    TEST-SEAM get_data.
      po_item = im_item->get_data( ).
    END-TEST-SEAM.

    IF po_item-lgort IS NOT INITIAL AND po_item-bstae IS INITIAL.

      TEST-SEAM ewm_check.
        DATA(ewm_active) = lo_utility->is_ewm_active(
          iv_plant = po_item-werks
          iv_stloc = po_item-lgort ).
      END-TEST-SEAM.

      IF ewm_active = abap_true.

        SELECT  SINGLE reswk
          FROM  flog_plant
          INTO  @DATA(supplying_plant)
          WHERE werks = @po_item-werks.

        IF sy-subrc = 0.

          DATA(sto_doc_type) = lo_utility->get_sto_doc_type(
            i_supplying_plant = supplying_plant               " Supplying (Issuing) Plant in Stock Transport Order
            i_plant           = po_item-werks                 " Plant
          ).

          IF sto_doc_type IS NOT INITIAL.

            IF ( po_item-knttp = 'F' OR po_item-knttp = 'N' ) AND po_item-pstyp = '7'.
              CLEAR po_item-bstae.
            ELSE.
              po_item-bstae = lo_utility->get_confirmation_ctrl_key(
              i_sto_doc_type     = sto_doc_type               " Order Type (Purchasing)
              i_plant            = po_item-werks              " Plant
              i_storage_location = po_item-lgort              " Storage Location
            ).
            ENDIF.

            TEST-SEAM set_data.
              im_item->set_data( im_data = po_item ).
            END-TEST-SEAM.

          ENDIF.
        ENDIF.
      ENDIF.
    ENDIF.

  ENDMETHOD.

