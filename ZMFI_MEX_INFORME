    METHODS: run.

  PRIVATE SECTION.

    TYPES:  BEGIN OF lty_t001,
                    bukrs TYPE bukrs,
            END OF lty_t001,
            lty_tt_t001 TYPE STANDARD TABLE OF lty_t001,

            BEGIN OF lty_bkpf,
