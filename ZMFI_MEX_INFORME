                                     it_bseg_gasto TYPE lty_tt_bseg_gasto
                                     it_bset TYPE lty_tt_bset
                                     it_with_item TYPE lty_tt_with_item
                                     it_lfa1 TYPE lty_tt_lfa1
                                     it_kna1 TYPE lty_tt_kna1
                                     it_stxh TYPE lxhme_stxh_t
                           CHANGING ct_table_alv TYPE ty_tt_report,

*ALV
             display_alv RAISING lcx_mex_informe,

             link_click FOR EVENT link_click OF cl_salv_events_table "click en enlace
                        IMPORTING row
                                  column,

             on_user_command FOR EVENT before_user_command OF cl_gui_alv_grid
                        IMPORTING e_ucomm,

             on_after_refresh FOR EVENT after_refresh OF cl_gui_alv_grid
                        IMPORTING sender.

    CLASS-DATA grid_ref TYPE REF TO cl_gui_alv_grid.
ENDCLASS.                    "lcl_mex_informe DEFINITION
