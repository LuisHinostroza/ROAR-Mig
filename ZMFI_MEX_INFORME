CLASS lcx_mex_informe DEFINITION INHERITING FROM cx_static_check.
  PUBLIC SECTION.
    " 1. Implementar la interfaz estándar de mensajes
    INTERFACES if_t100_message.

    " 2. Variables para recibir las variables del mensaje (&1, &2...)
    DATA: mv_msgid TYPE symsgid,
          mv_msgno TYPE symsgno,
          mv_v1    TYPE symsgv,
          mv_v2    TYPE symsgv,
          mv_v3    TYPE symsgv,
          mv_v4    TYPE symsgv.

    " 3. Constructor personalizado para hacer la llamada fácil
    METHODS constructor
      IMPORTING
        iv_msgid TYPE symsgid DEFAULT '00'
        iv_msgno TYPE symsgno DEFAULT '000'
        iv_v1    TYPE symsgv  OPTIONAL
        iv_v2    TYPE symsgv  OPTIONAL
        iv_v3    TYPE symsgv  OPTIONAL
        iv_v4    TYPE symsgv  OPTIONAL.
ENDCLASS.                    "lcx_mex_informe DEFINITION

*----------------------------------------------------------------------*
*       CLASS lcl_mex_informe DEFINITION
*----------------------------------------------------------------------*
*
*----------------------------------------------------------------------*
CLASS lcl_mex_informe DEFINITION.

  PUBLIC SECTION.
    TYPES: BEGIN OF ty_report,
             sociedad             TYPE bukrs,
             ejercicio            TYPE gjahr,
             numerodocumento      TYPE belnr_d, "12
             posicion             TYPE buzei,
             fechadocumento       TYPE bldat,   "1
             fechacontabilizacion TYPE budat,   "2
             periodo              TYPE monat,   "3
             referencia           TYPE xblnr1,  "4
             nuevofoliofiscal     TYPE string,  "5
             importemd            TYPE wrbtr,   "6
             monedamd             TYPE waers,   "7
             importeml            TYPE dmbtr,   "8
             indicadoriva         TYPE mwskz,   "9
             importeiva           TYPE fwste,   "10
             retenciones          TYPE wt_wt1,  "11
             doccompensacion      TYPE augbl,   "13
             fechacompensacion    TYPE augdt,   "14
             clasedocumento       TYPE blart,   "15
             acreedor             TYPE lifnr,   "16
             cliente              TYPE kunnr,   "17
             niftercero           TYPE stcd1,   "18
             nombretercero        TYPE name1_gp,"19
             paistercero          TYPE land1_gp,"20
             cptercero            TYPE pstlz,   "21
             cuentagasto          TYPE hkont,   "22
             cuentaiva            TYPE hkont,   "23
