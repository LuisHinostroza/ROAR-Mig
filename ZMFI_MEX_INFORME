             get_tercero_data IMPORTING it_bseg TYPE lty_tt_bseg
                              CHANGING ct_lfa1 TYPE lty_tt_lfa1
                                       ct_kna1 TYPE lty_tt_kna1,

             get_stxh IMPORTING it_bkpf TYPE lty_tt_bkpf
                      CHANGING ct_stxh TYPE lxhme_stxh_t,

*Inserción en tabla
             insert_bseg IMPORTING is_bseg TYPE lty_bseg
