    LOOP AT in-business_partner-tax_number ASSIGNING FIELD-SYMBOL(<ls_tax_number>).
      IF <ls_tax_number>-country_code IS INITIAL.
        CONTINUE.
      ENDIF.

      CLEAR ls_taxdetails.
      ls_taxdetails-taxtype = <ls_tax_number>-country_code && <ls_tax_number>-tax_identification_number_type-content.
      IF <ls_tax_number>-party_tax_id-content IS NOT INITIAL.
        ls_taxdetails-taxnumber = <ls_tax_number>-party_tax_id-content.
      ELSE.
        ls_taxdetails-taxnumxl = <ls_tax_number>-long_party_tax_id-content.
      ENDIF.
      APPEND ls_taxdetails TO lt_taxdetails.

      IF ls_taxdetails-taxtype = lc_nif_ppal.
*             Formato NIF Personas fisicas
        ls_taxdetails-taxnumber = condense( ls_taxdetails-taxnumber ).
        lv_len = strlen( ls_taxdetails-taxnumber ).
        IF     lv_len = 9 AND ls_taxdetails-taxnumber+8(1) CO sy-abcde
           AND ls_taxdetails-taxnumber(8) CO lc_numbers.  "#EC CI_MAGIC
          lv_person = abap_true.
        ELSEIF lv_len = 9 AND ls_taxdetails-taxnumber(1) CO lc_nie
           AND ls_taxdetails-taxnumber+1(7) CO lc_numbers. "#EC CI_MAGIC
          lv_person = abap_true.
        ENDIF.
      ELSE.

        lv_isnot_nif_ppal = abap_true.

        SELECT SINGLE taxtype,
                      type,
                      name
          INTO @DATA(ls_tax_det)
