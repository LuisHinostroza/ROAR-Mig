FUNCTION zmmmmf_get_zterm.
*"----------------------------------------------------------------------
*"*"Interfase local
*"  IMPORTING
*"     REFERENCE(I_LIFNR) TYPE  LFB1-LIFNR
*"  CHANGING
*"     REFERENCE(CT_PURCHASING) TYPE  VMDS_EI_PURCHASING_T OPTIONAL
*"----------------------------------------------------------------------
  TYPES: BEGIN OF t_lfm1,
           ekorg TYPE lfm1-ekorg,
           zterm TYPE lfm1-zterm,
         END OF t_lfm1.
  DATA: lt_lfm1 TYPE STANDARD TABLE OF t_lfm1,
        ls_lfm1 LIKE LINE OF lt_lfm1.
  CONSTANTS: lc_task_m TYPE vmds_ei_purchasing-task VALUE 'M',
             lc_task_i TYPE vmds_ei_purchasing-task VALUE 'I',
             lc_task_u TYPE vmds_ei_purchasing-task VALUE 'U'.
  FIELD-SYMBOLS: <ls_purchasing> TYPE LINE OF vmds_ei_purchasing_t.
  SELECT ekorg,
         zterm
    INTO TABLE @DATA(lt_zterm)
    FROM zmmmt_slp_zterm.
  IF sy-subrc = 0.
    SELECT ekorg,
           zterm
      INTO TABLE @lt_lfm1
      FROM lfm1
      WHERE lifnr = @i_lifnr.
    IF sy-subrc = 0.

    ENDIF.
    LOOP AT ct_purchasing ASSIGNING <ls_purchasing>.
      IF ( <ls_purchasing>-task = lc_task_m
      OR <ls_purchasing>-task = lc_task_i
      OR <ls_purchasing>-task = lc_task_u ) AND <ls_purchasing>-data-zterm IS INITIAL.
        READ TABLE lt_zterm INTO DATA(ls_zterm) WITH KEY ekorg = <ls_purchasing>-data_key-ekorg.
        IF sy-subrc = 0.
          CLEAR ls_lfm1.
          READ TABLE lt_lfm1 INTO ls_lfm1 WITH KEY ekorg = <ls_purchasing>-data_key-ekorg.
          IF ( sy-subrc <> 0 OR ls_lfm1-zterm IS INITIAL ) AND ls_zterm-zterm IS NOT INITIAL.
            <ls_purchasing>-data-zterm = ls_zterm-zterm.
            <ls_purchasing>-datax-zterm = abap_true.
          ELSEIF ls_lfm1-zterm IS NOT INITIAL.
            <ls_purchasing>-data-zterm = ls_lfm1-zterm.
            <ls_purchasing>-datax-zterm = abap_true.
          ENDIF.
        ENDIF.
        IF <ls_purchasing>-data-zterm IS INITIAL.
          <ls_purchasing>-datax-zterm = abap_false.
        ENDIF.
      ENDIF.
    ENDLOOP.
  ENDIF.

ENDFUNCTION.
