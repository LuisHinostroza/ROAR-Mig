*&---------------------------------------------------------------------*
*&      Form  CONVERT_INTO_ALT_LOC_CURR (EURO)
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM CONVERT_INTO_ALT_LOC_CURR.                             " <--- Euro

        IF WDMBTR <> 0.                                     " <--- Euro
          H_WDMBTR = WDMBTR.                                " <--- Euro
          CALL FUNCTION 'CONVERT_TO_FOREIGN_CURRENCY'       " <--- Euro
               EXPORTING DATE             = CONVDAT         " <--- Euro
                         FOREIGN_CURRENCY = ALTCURR         " <--- Euro
                         LOCAL_AMOUNT     = WDMBTR          " <--- Euro
                         LOCAL_CURRENCY   = T001-WAERS      " <--- Euro
*                         rate             = ???            " <--- Euro
                         TYPE_OF_RATE     = 'M'             " <--- Euro
               IMPORTING FOREIGN_AMOUNT   = WDMBTR.         " <--- Euro
          ALT_RATE = WDMBTR / H_WDMBTR.                     " <--- Euro
          WQSSHB = ALT_RATE * WQSSHB.                       " <--- Euro
          WQBSHB = ALT_RATE * WQBSHB.                       " <--- Euro
          WQSFBT = ALT_RATE * WQSFBT.                       " <--- Euro
          NETTO  = ALT_RATE * NETTO.                        " <--- Euro
        ENDIF.                                              " <--- Euro

ENDFORM.                    " CONVERT_INTO_ALT_LOC_CURR     " <--- Euro

*&---------------------------------------------------------------------*
*&      Form  CONVERT_INTO_LOC_CURR_OLD_WT
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM CONVERT_INTO_LOC_CURR_OLD_WT.

*---------------- Conversion at invoice time ---------------------------
    IF UMRECHN = 'X'.

*     Converts WT base of old WT

*     Invoice currency -> local currency at clearing date
      WQSSHB = BSIK-QSSHB.  " Intermediate value: WT base in inv. curr.
      IF CURR_INV NE T001-WAERS.
        CALL FUNCTION 'CONVERT_TO_LOCAL_CURRENCY'
             EXPORTING DATE             = INV_DATE
                       FOREIGN_CURRENCY = CURR_INV
                       LOCAL_CURRENCY   = T001-WAERS
                       FOREIGN_AMOUNT   = BSIK-QSSHB
                       RATE             = RATE_INV
                       TYPE_OF_RATE     = 'M'
             IMPORTING LOCAL_AMOUNT     = BSIK-QSSHB.
      ENDIF.

*     WT amount and base from clr. curr. -> local curr. at inv. date
      IF CURR_PAY NE T001-WAERS.
        IF CURR_PAY = CURR_INV.
          CALL FUNCTION 'CONVERT_TO_LOCAL_CURRENCY'
               EXPORTING DATE             = INV_DATE
                         FOREIGN_AMOUNT   = BSIK-QBSHB
                         FOREIGN_CURRENCY = CURR_PAY
                         LOCAL_CURRENCY   = T001-WAERS
                         RATE             = RATE_INV
                         TYPE_OF_RATE     = 'M'
               IMPORTING LOCAL_AMOUNT     = BSIK-QBSHB.
        ELSE.
          CALL FUNCTION 'CONVERT_TO_LOCAL_CURRENCY'
               EXPORTING DATE             = INV_DATE
                         FOREIGN_AMOUNT   = BSIK-QBSHB
                         FOREIGN_CURRENCY = CURR_PAY
                         LOCAL_CURRENCY   = T001-WAERS
*                        rate from tcurr
                         TYPE_OF_RATE     = 'M'
               IMPORTING LOCAL_AMOUNT     = BSIK-QBSHB.
        ENDIF.
      ENDIF.

*     Converts invoice amount into local currency
      IF WQSSHB NE 0.
         RATE = BSIK-QSSHB / WQSSHB.
         BSIK-DMBTR = BSIK-WRBTR * RATE.
         CLEAR: WQSSHB,
                RATE.
      ENDIF.

*---------------- Conversion at payment time ---------------------------
    ELSE.

*     Converts WT base of old WT

      IF CURR_INV NE T001-WAERS.
        WQSSHB = BSIK-QSSHB.
        IF CURR_INV = CURR_PAY.
        CALL FUNCTION 'CONVERT_TO_LOCAL_CURRENCY'
             EXPORTING DATE             = PAY_DATE
                       FOREIGN_CURRENCY = CURR_INV
                       LOCAL_CURRENCY   = T001-WAERS
                       FOREIGN_AMOUNT   = BSIK-QSSHB
                       RATE             = RATE_PAY
                       TYPE_OF_RATE     = 'M'
             IMPORTING LOCAL_AMOUNT     = BSIK-QSSHB.
        ELSE.
          CALL FUNCTION 'CONVERT_TO_LOCAL_CURRENCY'
               EXPORTING DATE             = PAY_DATE
                         FOREIGN_CURRENCY = CURR_INV
                         LOCAL_CURRENCY   = T001-WAERS
                         FOREIGN_AMOUNT   = BSIK-QSSHB
*                        rate from tcurr
                         TYPE_OF_RATE     = 'M'
               IMPORTING LOCAL_AMOUNT     = BSIK-QSSHB.
        ENDIF.

*       Converts invoice amount
        IF WQSSHB NE 0.
          RATE = BSIK-QSSHB / WQSSHB.
          BSIK-DMBTR = BSIK-WRBTR * RATE.
          CLEAR: WQSSHB,
                 RATE.
        ENDIF.
      ENDIF.

*     Converts WT amount of old WT
      IF CURR_PAY NE T001-WAERS.
        CALL FUNCTION 'CONVERT_TO_LOCAL_CURRENCY'
             EXPORTING DATE             = PAY_DATE
                       FOREIGN_CURRENCY = CURR_PAY
                       LOCAL_CURRENCY   = T001-WAERS
                       FOREIGN_AMOUNT   = BSIK-QBSHB
                       RATE             = RATE_PAY
                       TYPE_OF_RATE     = 'M'
             IMPORTING LOCAL_AMOUNT     = BSIK-QBSHB.
      ENDIF.

    ENDIF.                                          " End of conversion

ENDFORM.                    " CONVERT_INTO_LOC_CURR_OLD_WT

