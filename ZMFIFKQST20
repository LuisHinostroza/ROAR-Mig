*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM convert_into_loc_curr_old_wt.

*---------------- Conversion at invoice time ---------------------------
  IF umrechn = 'X'.

*     Converts WT base of old WT

*     Invoice currency -> local currency at clearing date

*    wqsshb = bsik-qsshb.  " Intermediate value: WT base in inv. curr.            "===> (DEL)   JLRA (RUBIOA2) - CORRECCIÓN - 02.07.2026
    wqsshb = CONV #( bsik-qsshb ).  " Intermediate value: WT base in inv. curr.   "===> (INS)   JLRA (RUBIOA2) - CORRECCIÓN - 02.07.2026

    IF curr_inv NE t001-waers.
      CALL FUNCTION 'CONVERT_TO_LOCAL_CURRENCY'
        EXPORTING
          date             = inv_date
          foreign_currency = curr_inv
          local_currency   = t001-waers
          foreign_amount   = bsik-qsshb
          rate             = rate_inv
          type_of_rate     = 'M'
        IMPORTING
          local_amount     = bsik-qsshb.
    ENDIF.

*     WT amount and base from clr. curr. -> local curr. at inv. date
    IF curr_pay NE t001-waers.
      IF curr_pay = curr_inv.
        CALL FUNCTION 'CONVERT_TO_LOCAL_CURRENCY'
          EXPORTING
            date             = inv_date
            foreign_amount   = bsik-qbshb
            foreign_currency = curr_pay
            local_currency   = t001-waers
            rate             = rate_inv
            type_of_rate     = 'M'
          IMPORTING
            local_amount     = bsik-qbshb.
      ELSE.
        CALL FUNCTION 'CONVERT_TO_LOCAL_CURRENCY'
          EXPORTING
            date             = inv_date
            foreign_amount   = bsik-qbshb
            foreign_currency = curr_pay
            local_currency   = t001-waers
*                        rate from tcurr
            type_of_rate     = 'M'
          IMPORTING
            local_amount     = bsik-qbshb.
      ENDIF.
    ENDIF.

*     Converts invoice amount into local currency
    IF wqsshb NE 0.
*===> (MOD)   JLRA (RUBIOA2) - CORRECCIÓN - 02.07.2026  (BEGIN) <===
* OLD CODE :
*      rate = bsik-qsshb / wqsshb.
*      bsik-dmbtr = bsik-wrbtr * rate.
*
* NEW CODE :
      rate = CONV decfloat34( bsik-qsshb )  /
             CONV decfloat34( wqsshb ).
      bsik-dmbtr = CONV decfloat34( bsik-wrbtr ) * CONV decfloat34( rate ).
*<=== (MOD)   JLRA (RUBIOA2) - CORRECCIÓN - 02.07.2026 (END) <===

      CLEAR: wqsshb,
             rate.
    ENDIF.

*---------------- Conversion at payment time ---------------------------
  ELSE.

*     Converts WT base of old WT

    IF curr_inv NE t001-waers.

*      wqsshb = bsik-qsshb.          "===> (DEL)   JLRA (RUBIOA2) - CORRECCIÓN - 02.07.2026
      wqsshb = CONV #( bsik-qsshb ). "===> (INS)   JLRA (RUBIOA2) - CORRECCIÓN - 02.07.2026

      IF curr_inv = curr_pay.
        CALL FUNCTION 'CONVERT_TO_LOCAL_CURRENCY'
          EXPORTING
            date             = pay_date
            foreign_currency = curr_inv
            local_currency   = t001-waers
            foreign_amount   = bsik-qsshb
            rate             = rate_pay
            type_of_rate     = 'M'
          IMPORTING
            local_amount     = bsik-qsshb.
      ELSE.
        CALL FUNCTION 'CONVERT_TO_LOCAL_CURRENCY'
          EXPORTING
            date             = pay_date
            foreign_currency = curr_inv
            local_currency   = t001-waers
            foreign_amount   = bsik-qsshb
*                        rate from tcurr
            type_of_rate     = 'M'
          IMPORTING
            local_amount     = bsik-qsshb.
      ENDIF.

*       Converts invoice amount
      IF wqsshb NE 0.

*===> (MOD)   JLRA (RUBIOA2) - CORRECCIÓN - 02.07.2026  (BEGIN) <===
* OLD CODE:
*        rate = bsik-qsshb / wqsshb.
*        bsik-dmbtr = bsik-wrbtr * rate.
*
* NEW CODE:
        rate = CONV decfloat34( bsik-qsshb ) /
               CONV decfloat34( wqsshb ).

        bsik-dmbtr = CONV decfloat34( bsik-wrbtr ) * CONV decfloat34( rate ).
*<=== (INS)   JLRA (RUBIOA2) - CORRECCIÓN - 02.07.2026  (END) <===


        CLEAR: wqsshb,
               rate.
      ENDIF.
    ENDIF.

*     Converts WT amount of old WT
    IF curr_pay NE t001-waers.
      CALL FUNCTION 'CONVERT_TO_LOCAL_CURRENCY'
        EXPORTING
          date             = pay_date
          foreign_currency = curr_pay
          local_currency   = t001-waers
          foreign_amount   = bsik-qbshb
          rate             = rate_pay
          type_of_rate     = 'M'
        IMPORTING
          local_amount     = bsik-qbshb.
    ENDIF.

  ENDIF.                                          " End of conversion

ENDFORM.                    " CONVERT_INTO_LOC_CURR_OLD_WT

