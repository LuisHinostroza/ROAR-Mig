  lv_vdmbtr = CONV #( vdmbtr ). "===> (INS)   JLRA (RUBIOA2) - CORRECCIÓN - 02.07.2026
*  netto  = wdmbtr - vdmbtr.    "===> (DEL)   JLRA (RUBIOA2) - CORRECCIÓN - 02.07.2026
  netto  = wdmbtr - lv_vdmbtr.  "===> (INS)   JLRA (RUBIOA2) - CORRECCIÓN - 02.07.2026

