*  CASE s_rrcty-low.
*    WHEN c_2.
*      lv_blart = c_rt.
*    WHEN c_0.
*      lv_blart = c_zs.
*    WHEN OTHERS.
*      MESSAGE 'Seleccione tipo de registro válido.'(020) TYPE 'I'.
*      EXIT.
*  ENDCASE.
  lv_cont_cty = 0.
  LOOP AT s_rrcty INTO ls_rrcty.
    CASE ls_rrcty-low.
      WHEN c_2.
        lv_blart = c_rt.
        lv_cont_cty = lv_cont_cty + 1.
      WHEN c_0.
        lv_blart = c_zs.
        lv_cont_cty = lv_cont_cty + 1.
      WHEN OTHERS.
        MESSAGE 'Seleccione tipo de registro válido.'(020) TYPE 'I'.
        lv_cont_cty = 0.
        EXIT.
    ENDCASE.
  ENDLOOP.
  IF lv_cont_cty = 2.
    lv_blart = c_zs.
  ENDIF.
