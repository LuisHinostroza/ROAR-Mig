*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM f_saldo_cero  TABLES p_show STRUCTURE w_show_aux.

* tabla para eliminar registro con saldo 0
  TYPES: BEGIN OF ty_aux,
    rbukrs  TYPE  bukrs,
    ryear TYPE  gjahr,
    rbusa TYPE  gsber,
    rtcur TYPE rtcur,
    racct TYPE  racct,
    negap TYPE  xnegp,
    rzzc01 TYPE  zzc01,
    rzzc02  TYPE  zzc02,
    rzzc03 TYPE  zzc03,
    zzc04  TYPE  zzc04,
    rzzc08  TYPE  zzc08,
    rzzc11 TYPE  zzc11,
    docdate TYPE  rl_docdate,
    shkzg TYPE  shkzg,
    rzzc12  TYPE  zzc12,
    rcntr TYPE  kostl,
    vbund TYPE  vbund,
    hslxx TYPE  hslxx9,
    tslxx TYPE tslxx9,
    rzzc06  TYPE  zzc06,
    rzzc07  TYPE  zzc07,
    rzzc13  TYPE  zzc13,
    zzc09 TYPE  zzc09,
    anln1 TYPE  anln1,
    zz0001  TYPE  zz0001,
   END OF ty_aux.

  DATA: lt_tab TYPE TABLE OF ty_aux,
        ls_tab TYPE ty_aux,
        lv_sum TYPE hslxx9,
        lv_sum2 TYPE tslxx9.
  FIELD-SYMBOLS <fs_tab> TYPE ty_aux.

  FREE lt_tab.
  LOOP AT p_show.
    CLEAR ls_tab.
    MOVE-CORRESPONDING p_show TO ls_tab.
    APPEND ls_tab TO lt_tab.
  ENDLOOP.

  SORT lt_tab BY rbukrs ryear rbusa rtcur racct negap rzzc01 rzzc02 rzzc03 zzc04 rzzc08 rzzc11.

  LOOP AT lt_tab ASSIGNING <fs_tab>.
    AT NEW rzzc11.
      CLEAR: lv_sum, lv_sum2.
    ENDAT.
    lv_sum = lv_sum + <fs_tab>-hslxx.
    lv_sum2 = lv_sum2 + <fs_tab>-tslxx.

    AT END OF rzzc11.
      IF lv_sum = 0 AND lv_sum2 = 0.
        DELETE lt_tab WHERE rbukrs = <fs_tab>-rbukrs
                        AND ryear  = <fs_tab>-ryear
                        AND rbusa  = <fs_tab>-rbusa
                        AND rtcur  = <fs_tab>-rtcur
                        AND racct  = <fs_tab>-racct
                        AND negap  = <fs_tab>-negap
                        AND rzzc01 = <fs_tab>-rzzc01
                        AND rzzc02 = <fs_tab>-rzzc02
                        AND rzzc03 = <fs_tab>-rzzc03
                        AND zzc04  = <fs_tab>-zzc04
                        AND rzzc08 = <fs_tab>-rzzc08
                        AND rzzc11 = <fs_tab>-rzzc11.
      ENDIF.
    ENDAT.
  ENDLOOP.

  FREE: p_show.

  LOOP AT lt_tab ASSIGNING <fs_tab>.
    MOVE-CORRESPONDING <fs_tab> TO p_show.
    APPEND p_show.
  ENDLOOP.

ENDFORM.                    " F_SALDO_CERO
