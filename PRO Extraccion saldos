*&---------------------------------------------------------------------*
*&      Form  F_OBTIENE_IMPORTE_FINAL_MAP4
*&---------------------------------------------------------------------*
*      Clonada de la F_OBTIENE_IMPORTE_FINAL_MAP1 cambiando el tipo
*----------------------------------------------------------------------*
FORM f_obtiene_importe_final_map4 USING p_i_zzmapxt STRUCTURE wa_zzmap4t
                                        p_lastmonth
                               CHANGING p_hslxx
                                        p_tslxx.
  FIELD-SYMBOLS: <fs_campo> TYPE any.
  DATA: l_nombre_campo(40),
        l_month(2) TYPE n.
  CLEAR p_hslxx.

  IF p_lastmonth  > 0.
    DO 16 TIMES.
      l_month = l_month + 1.
      CONCATENATE 'HSL' l_month INTO l_nombre_campo.
      ASSIGN COMPONENT l_nombre_campo OF STRUCTURE p_i_zzmapxt TO <fs_campo>.
      IF sy-subrc EQ 0.
        p_hslxx = p_hslxx + <fs_campo>.
      ENDIF.
    ENDDO.
  ENDIF.
  IF p_montr = abap_true.
    CLEAR l_month.
    IF p_lastmonth  > 0.
      DO 16 TIMES.
        l_month = l_month + 1.
        CONCATENATE 'TSL' l_month INTO l_nombre_campo.
        ASSIGN COMPONENT l_nombre_campo OF STRUCTURE p_i_zzmapxt TO <fs_campo>.
        IF sy-subrc EQ 0.
          p_tslxx = p_tslxx + <fs_campo>.
        ELSE.
          p_tslxx = p_hslxx.
        ENDIF.
      ENDDO.
    ENDIF.
  ELSE.
    p_tslxx = p_hslxx.
  ENDIF.
** CRG INI 31102025 Modificación moneda KWD
  IF p_i_zzmapxt-rtcur = 'KWD'.
    p_tslxx = p_tslxx / 10.
  ENDIF.
** CRG FIN 31102025
ENDFORM.                    " F_OBTIENE_IMPORTE_FINAL_MAP4

