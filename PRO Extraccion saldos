*&---------------------------------------------------------------------*
*&      Form  F_CHECK_LONG
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->P_P_I_SHOW_AUX  text
*----------------------------------------------------------------------*
FORM f_check_long  TABLES   p_i_show_aux STRUCTURE w_show_aux.
  DATA: lv_tabix TYPE sy-tabix,
        lv_hsl_txt TYPE string,
        lv_tsl_txt TYPE string,
        lv_len TYPE i,
        lv_flag_err TYPE c,
        lv_flag_exit TYPE c,
        lv_exit TYPE c,
        lt_show_aux LIKE p_i_show_aux[],
        lt_del_tabix TYPE STANDARD TABLE OF sy-tabix,
        lv_hslxx LIKE w_show_aux-hslxx,
        lv_tslxx LIKE w_show_aux-tslxx,
        lv_index TYPE sy-index.
  WHILE lv_flag_exit = space.
    CLEAR: lt_del_tabix[], lt_show_aux[].
    lv_exit = abap_true.
    LOOP AT p_i_show_aux INTO w_show_aux.
      lv_tabix = sy-tabix.
      CLEAR lv_flag_err.
      lv_hsl_txt = w_show_aux-hslxx.
      lv_tsl_txt = w_show_aux-tslxx.
      REPLACE ALL OCCURRENCES OF '.' IN lv_hsl_txt WITH '' IN CHARACTER MODE.
      REPLACE ALL OCCURRENCES OF '.' IN lv_tsl_txt WITH '' IN CHARACTER MODE.
      REPLACE ALL OCCURRENCES OF '-' IN lv_hsl_txt WITH '' IN CHARACTER MODE.
      REPLACE ALL OCCURRENCES OF '-' IN lv_tsl_txt WITH '' IN CHARACTER MODE.
      CONDENSE: lv_hsl_txt NO-GAPS,
                lv_tsl_txt NO-GAPS.
      lv_len = strlen( lv_hsl_txt ).
      IF lv_len > 13.
        lv_flag_err = abap_true.
      ENDIF.
      lv_len = strlen( lv_tsl_txt ).
      IF lv_len > 13.
        lv_flag_err = abap_true.
      ENDIF.
      IF lv_flag_err = abap_true.
        lv_hslxx = w_show_aux-hslxx.
        lv_tslxx = w_show_aux-tslxx.
        w_show_aux-hslxx = w_show_aux-hslxx / 10.
        w_show_aux-tslxx = w_show_aux-tslxx / 10.
        DO 10 TIMES.
          lv_index = sy-index.
          lv_hslxx = lv_hslxx - w_show_aux-hslxx.
          lv_tslxx = lv_tslxx - w_show_aux-tslxx.
          IF lv_index = 10.
            w_show_aux-hslxx = w_show_aux-hslxx + lv_hslxx.
            w_show_aux-tslxx = w_show_aux-tslxx + lv_tslxx.
          ENDIF.
          APPEND w_show_aux TO lt_show_aux.
        ENDDO.
        APPEND lv_tabix TO lt_del_tabix.
        lv_exit = space.
      ENDIF.
    ENDLOOP.
    IF lv_exit = abap_true.
      lv_flag_exit = abap_true.
    ELSE.
      SORT lt_del_tabix DESCENDING.
      LOOP AT lt_del_tabix INTO lv_tabix.
        DELETE p_i_show_aux INDEX lv_tabix.
      ENDLOOP.
      APPEND LINES OF lt_show_aux TO p_i_show_aux.
    ENDIF.
  ENDWHILE.

ENDFORM.                    " F_CHECK_LONG
