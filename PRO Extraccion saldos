          ls_return TYPE sy-subrc,
          t_table TYPE swfistring,
          w_i_final_out LIKE LINE OF i_final_out,
          w_table LIKE LINE OF t_table.

    v_filename = l_targetpath.
    LOOP AT p_i_final_out INTO w_i_final_out.
      w_table = w_i_final_out.
      APPEND w_table TO t_table.
    ENDLOOP.
    CALL FUNCTION 'ZMFIMF_DOWNLOAD_SERV' DESTINATION p_rfc2
      EXPORTING
        i_filename = v_filename
        i_tab      = t_table
      IMPORTING
        e_return   = ls_return.
