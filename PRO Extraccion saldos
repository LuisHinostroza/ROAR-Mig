*      -->P_C_SI  text
*      -->P_P_I_SHOW_AUX_DOCDATE  text
*      <--P_W_OUTITEM  text
*----------------------------------------------------------------------*
FORM f_crea_item_10  TABLES   p_i_final_out STRUCTURE w_final_out
                     USING    p_i_show_aux
                              p_c_si
                              p_i_show_aux_docdate
                     CHANGING p_w_outitem  STRUCTURE w_outitem.

  DATA: lv_hslxx LIKE w_show_aux-hslxx,
        lv_tslxx LIKE w_show_aux-tslxx,
        lv_index TYPE sy-index,
        lv_times TYPE i VALUE 1,
        lv_hslxx_aux LIKE w_show_aux-hslxx,
        lv_tslxx_aux LIKE w_show_aux-tslxx,
        lv_flag TYPE c.
  lv_hslxx = l_hslxx_99.
  lv_tslxx = l_hslxx2_99.
