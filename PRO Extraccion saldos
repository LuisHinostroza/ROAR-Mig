FORM f_obtener_ultimo_dia_mes  CHANGING p_docdate
                                        p_lastmonth.
  DATA: l_month(2) TYPE n,
        lv_year TYPE gjahr.


  IF p_saldo EQ abap_true.
    lv_year = p_ryear - 1." DEVK982456 AMALON S 7000000356: Programa Migración para USA
    CONCATENATE lv_year '1231' INTO p_docdate.
    p_lastmonth = 12.
  ELSE.
    p_lastmonth = lv_rpmax.
    IF p_lastmonth >= 12.
      p_lastmonth = 12.
    ENDIF.
    l_month = p_lastmonth.
    CONCATENATE p_ryear l_month '01' INTO p_docdate.
    CALL FUNCTION 'FKK_LAST_DAY_OF_MONTH'
      EXPORTING
        day_in            = p_docdate
      IMPORTING
        last_day_of_month = p_docdate
      EXCEPTIONS
        day_in_no_date    = 1
        OTHERS            = 2.
  ENDIF.
