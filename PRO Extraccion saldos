*----------------------------------------------------------------------*
FORM f_descarga_archivo  TABLES   p_i_final_out
                         CHANGING p_filename.
  DATA: l_titel(20),
        l_txt1(150),
        l_txt2(150).
  DATA: lv_file_sep TYPE c,
        lv_ext TYPE c LENGTH 5,
        lv_filepath TYPE string,
        lv_msg TYPE string,
        lv_char TYPE string,
        lv_filename TYPE string.

  l_titel = text-007.
  l_txt1  = text-008.
  l_txt2  = text-009.
  IF g_error IS NOT INITIAL.
    CALL FUNCTION 'POPUP_TO_INFORM'
      EXPORTING
        titel = l_titel
        txt1  = l_txt1
        txt2  = l_txt2
*       TXT3  = ' '
*       TXT4  = ' '
      .
  ENDIF.
  IF p_pres = c_si.
    CALL METHOD cl_gui_frontend_services=>get_file_separator
      CHANGING
        file_separator = lv_file_sep.

    IF p_csv = abap_true.
      MOVE '.CSV' TO lv_ext.
    ELSE.
      MOVE '.TXT' TO lv_ext.
    ENDIF.
    IF lv_flag_neg EQ abap_true.
      CONCATENATE lv_blart s_bukrs-low  sy-datum '_' p_infnum 'SALN' lv_ext INTO p_filename.
      CONCATENATE p_filna lv_file_sep p_filename INTO lv_filepath.
    ELSE.
      CONCATENATE lv_blart s_bukrs-low  sy-datum '_' p_infnum  'SAL' lv_ext INTO p_filename.
      CONCATENATE p_filna lv_file_sep p_filename INTO lv_filepath.
    ENDIF.
    IF p_part EQ abap_true.
      MOVE lv_file_cont TO lv_char.
      CONDENSE lv_char.
      CONCATENATE  lv_char '.CSV' INTO lv_char.
      REPLACE: '.CSV' INTO lv_filepath WITH lv_char,
               '.CSV' INTO p_filename WITH lv_char.
    ENDIF.
    CALL METHOD cl_gui_frontend_services=>gui_download
      EXPORTING
        filename                = lv_filepath
      CHANGING
        data_tab                = p_i_final_out[]
      EXCEPTIONS
        file_write_error        = 1
        no_batch                = 2
        gui_refuse_filetransfer = 3
        invalid_type            = 4
        no_authority            = 5
        unknown_error           = 6
        header_not_allowed      = 7
        separator_not_allowed   = 8
        filesize_not_allowed    = 9
        header_too_long         = 10
        dp_error_create         = 11
        dp_error_send           = 12
        dp_error_write          = 13
        unknown_dp_error        = 14
        access_denied           = 15
        dp_out_of_memory        = 16
        disk_full               = 17
        dp_timeout              = 18
        file_not_found          = 19
        dataprovider_exception  = 20
        control_flush_error     = 21
        not_supported_by_gui    = 22
        error_no_gui            = 23
        OTHERS                  = 24.
    IF sy-subrc <> 0.
      MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
              WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
    ELSE.
      CONCATENATE 'Se descargo el fichero' lv_filepath 'Satisfactoriamente' INTO lv_msg
      SEPARATED BY space.
      MESSAGE lv_msg TYPE 'S' DISPLAY LIKE 'I'.
    ENDIF.
  ENDIF.
  IF p_appl = c_si.
    DATA: l_targetpath TYPE saepfad .

    IF p_csv = abap_true.
      MOVE '.CSV' TO lv_ext.
    ELSE.
      MOVE '.TXT' TO lv_ext.
    ENDIF.
    IF lv_flag_neg EQ abap_true.
      CONCATENATE lv_blart s_bukrs-low sy-datum '_' p_infnum 'SALN' lv_ext INTO p_filename.
      CONCATENATE p_filna '/' p_filename INTO l_targetpath.
    ELSE.
      CONCATENATE lv_blart s_bukrs-low sy-datum '_' p_infnum 'SAL' lv_ext INTO p_filename.
      CONCATENATE p_filna '/' p_filename INTO l_targetpath.
    ENDIF.
    IF p_part EQ abap_true.
      MOVE lv_file_cont TO lv_char.
      CONDENSE lv_char.
      CONCATENATE  lv_char '.CSV' INTO lv_char.
      REPLACE: '.CSV' INTO l_targetpath WITH lv_char,
               '.CSV' INTO p_filename WITH lv_char.
    ENDIF.

*** CRG INI modif 07.08.2025 subir el fichero al servidor destino.
