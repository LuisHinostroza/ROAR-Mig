                                       AND ( zzc02 = wa_zzmap3t-rzzc02 OR zzc02 = '*').
      p_i_show-zz0001 = gs_zz0001-zz0001.
      EXIT.
    ENDLOOP.

    p_i_show-docdate = l_docdate.
    IF p_total = c_si OR
      ( p_comb2 = c_si AND lv_combi = space ).
      PERFORM f_obtiene_importe_final_map3  USING wa_zzmap3t
                                                  l_lastmonth
                                        CHANGING  p_i_show-hslxx
                                                  p_i_show-tslxx.
    ENDIF.
    IF p_delta = c_si OR
      ( p_combi = c_si AND lv_combi = space ).
      PERFORM f_obtiene_importe_delta_map3 USING  wa_zzmap3t
                                                  l_lastmonth
                                        CHANGING  p_i_show-hslxx
                                                  p_i_show-tslxx.
    ENDIF.
    IF lv_combi = c_si.
      PERFORM f_obtiene_importe_combi_map3 USING  wa_zzmap3t
                                                  l_lastmonth
                                        CHANGING  p_i_show-hslxx
                                                  p_i_show-tslxx.
    ENDIF.
    IF p_i_show-tslxx  >= 0  AND p_i_show-hslxx  >= 0.
*      p_i_show-shkzg = 'S'.
      p_i_show-shkzg = 'D'.
    ELSE.
      p_i_show-shkzg = 'H'.
    ENDIF.

** CRG 28032025 Se eliminan las línea con los dos importes a 0. Se elimina el "0" ya que si un importe es 0 no hay q tratarlo
    IF p_i_show-shkzg = 'H' AND ( ( p_i_show-tslxx  > 0 AND p_i_show-hslxx  < 0 ) OR ( p_i_show-tslxx  < 0 AND p_i_show-hslxx  > 0 ) ).
      ls_ref = p_i_show.
      IF p_i_show-hslxx  < 0.
        CLEAR ls_ref-tslxx.
        APPEND ls_ref TO p_i_show.
        ls_ref = p_i_show.
        CLEAR ls_ref-hslxx.
        ls_ref-shkzg = 'D'.
        APPEND ls_ref TO p_i_show.
      ELSE. "p_i_show-tslxx  < 0
        CLEAR ls_ref-hslxx.
        APPEND ls_ref TO p_i_show.
        ls_ref = p_i_show.
        CLEAR ls_ref-tslxx.
        ls_ref-shkzg = 'D'.
        APPEND ls_ref TO p_i_show.
      ENDIF.
    ELSE.
      IF p_i_show-tslxx <> 0 OR p_i_show-hslxx <> 0.
        APPEND p_i_show.
      ENDIF.
    ENDIF.

    CLEAR p_i_show.
  ENDLOOP.

ENDFORM.                    " F_LLENA_SHOW_MAP3
*&---------------------------------------------------------------------*
*&      Form  F_OBTIENE_IMPORTE_FINAL_MAP3
*&---------------------------------------------------------------------*
*      Clonada de la F_OBTIENE_IMPORTE_FINAL_MAP4 cambiando el tipo
*----------------------------------------------------------------------*
FORM f_obtiene_importe_final_map3 USING p_i_zzmapxt STRUCTURE wa_zzmap3t
                                        p_lastmonth
                               CHANGING p_hslxx
                                        p_tslxx.
  FIELD-SYMBOLS: <fs_campo> TYPE any.
  DATA: l_nombre_campo(40),
        l_month(2) TYPE n.
  CLEAR p_hslxx.

  IF p_lastmonth  > 0.
    DO 16 TIMES.
      l_month = l_month + 1.
      CONCATENATE 'HSL' l_month INTO l_nombre_campo.
      ASSIGN COMPONENT l_nombre_campo OF STRUCTURE p_i_zzmapxt TO <fs_campo>.
      IF sy-subrc EQ 0.
        p_hslxx = p_hslxx + <fs_campo>.
      ENDIF.
    ENDDO.
  ENDIF.
  IF p_montr = abap_true.
    CLEAR l_month.
    IF p_lastmonth  > 0.
      DO 16 TIMES.
        l_month = l_month + 1.
        CONCATENATE 'TSL' l_month INTO l_nombre_campo.
        ASSIGN COMPONENT l_nombre_campo OF STRUCTURE p_i_zzmapxt TO <fs_campo>.
        IF sy-subrc EQ 0.
          p_tslxx = p_tslxx + <fs_campo>.
        ELSE.
          p_tslxx = p_hslxx.
        ENDIF.
      ENDDO.
    ENDIF.
  ELSE.
    p_tslxx = p_hslxx.
  ENDIF.
** CRG INI 31102025 Modificación moneda KWD
  IF p_i_zzmapxt-rtcur = 'KWD'.
    p_tslxx = p_tslxx / 10.
  ENDIF.
** CRG FIN 31102025
ENDFORM.                    " F_OBTIENE_IMPORTE_FINAL_MAP3
*&---------------------------------------------------------------------*
*&      Form  F_OBTIENE_IMPORTE_DELTA_MAP3
*&---------------------------------------------------------------------*
* Clonada de F_OBTIENE_IMPORTE_DELTA_MAP4 cambiando el tipo
*----------------------------------------------------------------------*
FORM f_obtiene_importe_delta_map3  USING p_i_zzmapxt STRUCTURE wa_zzmap3t
                                         p_lastmonth
                                CHANGING p_hslxx
                                         p_tslxx.

  FIELD-SYMBOLS: <fs_campo> TYPE any.
  DATA: l_nombre_campo(40),
        l_month(2)     TYPE n.
  CLEAR p_hslxx.

  IF p_saldo = abap_false.
    CLEAR l_month.
    ADD lv_rpmax TO l_month.
    CONCATENATE 'HSL' l_month INTO l_nombre_campo.
    ASSIGN COMPONENT l_nombre_campo OF STRUCTURE p_i_zzmapxt TO <fs_campo>.
    IF sy-subrc EQ 0.
      p_hslxx = p_hslxx + <fs_campo>.
    ENDIF.

  ELSE.
    l_nombre_campo = c_hslvt.
    ASSIGN COMPONENT l_nombre_campo OF STRUCTURE p_i_zzmapxt TO <fs_campo>.
    IF sy-subrc EQ 0.
      p_hslxx = p_hslxx + <fs_campo>.
    ENDIF.
  ENDIF.
  IF p_montr = abap_true.
    IF p_saldo = abap_false.
      CLEAR l_month.
      ADD lv_rpmax TO l_month.
      CONCATENATE 'TSL' l_month INTO l_nombre_campo.
      ASSIGN COMPONENT l_nombre_campo OF STRUCTURE p_i_zzmapxt TO <fs_campo>.
      IF sy-subrc EQ 0.
        p_tslxx = p_tslxx + <fs_campo>.
      ELSE.
        p_tslxx = p_hslxx.
      ENDIF.

    ELSE.
      l_nombre_campo = c_tslvt.
      ASSIGN COMPONENT l_nombre_campo OF STRUCTURE p_i_zzmapxt TO <fs_campo>.
      IF sy-subrc EQ 0.
        p_tslxx = p_tslxx + <fs_campo>.
      ELSE.
        p_tslxx = p_hslxx.
      ENDIF.
    ENDIF.
  ELSE.
    p_tslxx = p_hslxx.
  ENDIF.
** CRG INI 31102025 Modificación moneda KWD
  IF p_i_zzmapxt-rtcur = 'KWD'.
    p_tslxx = p_tslxx / 10.
  ENDIF.
** CRG FIN 31102025
ENDFORM.                    " F_OBTIENE_IMPORTE_DELTA_MAP3
*&---------------------------------------------------------------------*
*&      Form  F_OBTIENE_IMPORTE_COMBI_MAP3
*&---------------------------------------------------------------------*
* Clonada de F_OBTIENE_IMPORTE_COMBI_MAP4 cambiando el tipo
*----------------------------------------------------------------------*
FORM f_obtiene_importe_combi_map3  USING p_i_zzmapxt STRUCTURE wa_zzmap3t
                                         p_lastmonth
                                CHANGING p_hslxx
                                         p_tslxx.

  FIELD-SYMBOLS: <fs_campo> TYPE any.
  DATA: l_nombre_campo(40),
        l_month(2)     TYPE n.
  CLEAR p_hslxx.


  l_nombre_campo = c_hslvt.
  ASSIGN COMPONENT l_nombre_campo OF STRUCTURE p_i_zzmapxt TO <fs_campo>.
  IF sy-subrc EQ 0.
    p_hslxx = p_hslxx + <fs_campo>.
  ENDIF.

  IF p_montr = abap_true.
    l_nombre_campo = c_tslvt.
    ASSIGN COMPONENT l_nombre_campo OF STRUCTURE p_i_zzmapxt TO <fs_campo>.
    IF sy-subrc EQ 0.
      p_tslxx = p_tslxx + <fs_campo>.
    ELSE.
      p_tslxx = p_hslxx.
    ENDIF.
  ELSE.
    p_tslxx = p_hslxx.
  ENDIF.
** CRG INI 31102025 Modificación moneda KWD
  IF p_i_zzmapxt-rtcur = 'KWD'.
    p_tslxx = p_tslxx / 10.
  ENDIF.
** CRG FIN 31102025
ENDFORM.                    " F_OBTIENE_IMPORTE_COMBI_MAP3
