      AND zzmap4t~ryear  = p_ryear
      AND zzmap4t~rtcur  IN p_rtcur
      AND zzmap4t~rzzs01 IN s_rzzs01.
  ENDIF.
  IF it_cta_bal IS NOT INITIAL.
    SELECT *
        FROM zzmap4t
        APPENDING TABLE  it_zzmap4t
         FOR ALL ENTRIES IN it_cta_bal
       WHERE rbukrs IN s_bukrs
         AND racct  = it_cta_bal-saknr
         AND rldnr  EQ lc_z4
         AND rrcty  IN s_rrcty
         AND rvers  IN r_rvers
         AND rtcur  IN p_rtcur
         AND ryear  = p_ryear.
    IF sy-subrc EQ 0.

    ENDIF.
  ENDIF.


