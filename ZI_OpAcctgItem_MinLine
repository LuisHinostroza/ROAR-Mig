2. ZI_CtrapProveedor
abap
@AccessControl.authorizationCheck: #NOT_REQUIRED
@VDM.viewType: #BASIC
@EndUserText.label: 'Contrapartida - Datos Proveedor'
define view entity ZI_CtrapProveedor
  as select from I_OperationalAcctgDocItem as K

  inner join ZI_OpAcctgItem_MinLine as Min
    on  Min.CompanyCode               = K.CompanyCode
    and Min.FiscalYear                = K.FiscalYear
    and Min.AccountingDocument        = K.AccountingDocument
    and Min.FinancialAccountType      = K.FinancialAccountType
    and Min.MinAccountingDocumentItem = K.AccountingDocumentItem

  association [0..1] to I_Supplier as _Supplier
    on _Supplier.Supplier = K.Supplier

{
  key K.CompanyCode,
  key K.FiscalYear,
  key K.AccountingDocument,
      K.Supplier,
      _Supplier.SupplierName,   // -- confirmar nombre exacto
      _Supplier.TaxNumber1      // -- confirmar nombre exacto
}
where K.FinancialAccountType = 'K'
