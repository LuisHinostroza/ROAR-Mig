Lista final: 5 CDS View Entities + 1 Metadata Extension + 1 DCL + 1 Service Definition + 1 Service Binding = 9 objetos
1. ZI_CtrapProveedor — Basic (DEFINE VIEW ENTITY)
abap
@AccessControl.authorizationCheck: #NOT_REQUIRED
@VDM.viewType: #BASIC
@EndUserText.label: 'Contrapartida - Datos Proveedor'
define view entity ZI_CtrapProveedor
  as select from I_OperationalAcctgDocItem as K

  association [0..1] to I_Supplier as _Supplier
    on _Supplier.Supplier = K.Supplier

{
  key K.CompanyCode,
  key K.FiscalYear,
  key K.AccountingDocument,
      K.Supplier,
      _Supplier.SupplierName,   // -- confirmar nombre exacto del campo en I_Supplier
      _Supplier.TaxNumber1      // -- confirmar nombre exacto del campo en I_Supplier
}
where K.FinancialAccountType = 'K'
  and K.AccountingDocumentItem = (
        select min( I2.AccountingDocumentItem )
          from I_OperationalAcctgDocItem as I2
         where I2.CompanyCode          = K.CompanyCode
           and I2.FiscalYear           = K.FiscalYear
           and I2.AccountingDocument   = K.AccountingDocument
           and I2.FinancialAccountType = 'K'
      )
